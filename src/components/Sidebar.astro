---
import { getCollection } from 'astro:content';
const posts = await getCollection('blog');

// Get current path from Astro.url
const currentPath = Astro.url.pathname;
const currentSlug = currentPath.split('/').pop();

const categories = {
  'career': 'Career Development',
  // 'chatGPT': 'Chat GPT',
  // 'tech-insights': 'Tech Insights',
  'ai-ml': 'AI stuff',
  'startup-journey': 'Startup Journey',
  // 'programming': 'Programming Tutorials',
  'content': 'Content creation',
  'fullstack': 'Fullstack Development',
};

const postsByCategory = Object.fromEntries(
  Object.keys(categories).map(category => [
    category,
    posts.filter(post => post.data.category === category)
  ])
);

// Find the category of the current post
const currentPost = posts.find(post => post.slug === currentSlug);
const currentCategory = currentPost?.data.category;
---

<aside class="fixed left-0 top-0 h-screen w-72 bg-gradient-to-b from-white to-gray-50 border-r border-gray-200 overflow-y-auto transform transition-transform duration-300 ease-in-out md:translate-x-0 -translate-x-full z-50 shadow-lg" id="sidebar">
  <div class="p-6">
    <div class="mb-8">
      <a href="/" class="block hover:opacity-80 transition-opacity">
        <h2 class="text-2xl font-bold bg-gradient-to-r from-primary-600 to-primary-400 bg-clip-text text-transparent">Aryan Singh</h2>
        <p class="text-sm text-gray-600 mt-1.5 font-medium">Engineer, Creator | 600K+ Followers</p>
      </a>
    </div>

    <div class="mb-6">
      <input
        type="search"
        placeholder="Search posts..."
        class="w-full px-4 py-2 text-sm rounded-xl border border-gray-200 focus:ring-2 focus:ring-primary-500 focus:border-primary-500 bg-gray-50 placeholder-gray-400 transition-all"
      />
    </div>

    <nav class="space-y-2">
      {Object.entries(categories).map(([key, label]) => {
        const isCurrentCategory = key === currentCategory;
        return (
          <div class="group">
            <button
              class:list={[
                "flex items-center justify-between w-full px-4 py-2.5 text-left rounded-xl transition-all duration-200",
                isCurrentCategory 
                  ? "text-primary-600 bg-primary-50 shadow-sm" 
                  : "text-gray-700 hover:bg-gray-100"
              ]}
              data-category={key}
            >
              <span class="font-medium">{label}</span>
              <svg
                class="w-4 h-4 transition-transform duration-200"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                style={isCurrentCategory ? "transform: rotate(0deg)" : "transform: rotate(-90deg)"}
              >
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
              </svg>
            </button>
            <ul class:list={["mt-1 space-y-1 px-2", !isCurrentCategory && "hidden"]}>
              {postsByCategory[key].map(post => (
                <li>
                  <a
                    href={`/blog/${post.slug}`}
                    class:list={[
                      "block px-4 py-2 text-sm transition-all duration-200 rounded-lg",
                      currentSlug === post.slug 
                        ? "text-primary-600 bg-primary-50 font-medium shadow-sm" 
                        : "text-gray-600 hover:text-primary-600 hover:bg-gray-100"
                    ]}
                  >
                    {post.data.title}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        );
      })}
    </nav>

    <div class="mt-8 pt-6 border-t border-gray-200">
      <div class="flex space-x-5 justify-center">
        <a href="https://twitter.com/singh1aryan" 
           target="_blank" 
           rel="noopener noreferrer" 
           class="text-gray-500 hover:text-primary-600 transition-colors duration-200">
          <span class="sr-only">Twitter</span>
          <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24">
            <path d="M8.29 20.251c7.547 0 11.675-6.253 11.675-11.675 0-.178 0-.355-.012-.53A8.348 8.348 0 0022 5.92a8.19 8.19 0 01-2.357.646 4.118 4.118 0 001.804-2.27 8.224 8.224 0 01-2.605.996 4.107 4.107 0 00-6.993 3.743 11.65 11.65 0 01-8.457-4.287 4.106 4.106 0 001.27 5.477A4.072 4.072 0 012.8 9.713v.052a4.105 4.105 0 003.292 4.022 4.095 4.095 0 01-1.853.07 4.108 4.108 0 003.834 2.85A8.233 8.233 0 012 18.407a11.616 11.616 0 006.29 1.84"></path>
          </svg>
        </a>
        <a href="https://linkedin.com/in/singh1aryan" 
           target="_blank" 
           rel="noopener noreferrer" 
           class="text-gray-500 hover:text-primary-600 transition-colors duration-200">
          <span class="sr-only">LinkedIn</span>
          <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24">
            <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
          </svg>
