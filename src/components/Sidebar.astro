---
import { getCollection } from 'astro:content';
const posts = await getCollection('blog');

const categories = {
  'tech-insights': 'Tech Insights',
  'ai-ml': 'AI/ML',
  'startup-journey': 'Startup Journey',
  'programming': 'Programming Tutorials',
  'career': 'Career Development'
};

const postsByCategory = Object.fromEntries(
  Object.keys(categories).map(category => [
    category,
    posts.filter(post => post.data.category === category)
  ])
);
---

<aside class="fixed left-0 top-0 h-screen w-64 bg-white border-r border-gray-200 overflow-y-auto transform transition-transform duration-300 ease-in-out md:translate-x-0 -translate-x-full" id="sidebar">
  <div class="p-6">
    <div class="mb-8">
      <h2 class="text-2xl font-bold text-gray-900">Aryan Singh</h2>
      <p class="text-sm text-gray-600 mt-2">Software Engineer | 6000+ Followers</p>
    </div>

    <div class="mb-6">
      <input
        type="search"
        placeholder="Search posts..."
        class="w-full px-4 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-primary-500 focus:border-primary-500"
      />
    </div>

    <nav>
      {Object.entries(categories).map(([key, label]) => (
        <div class="mb-4">
          <button
            class="flex items-center justify-between w-full px-2 py-2 text-left text-gray-700 hover:bg-gray-100 rounded-lg"
            data-category={key}
          >
            <span class="font-medium">{label}</span>
            <svg
              class="w-4 h-4 transition-transform"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M19 9l-7 7-7-7"
              />
            </svg>
          </button>
          <ul class="ml-4 mt-2 space-y-2">
            {postsByCategory[key].map(post => (
              <li>
                <a
                  href={`/blog/${post.slug}`}
                  class="block px-2 py-1 text-sm text-gray-600 hover:text-primary-600 hover:bg-gray-50 rounded"
                >
                  {post.data.title}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </nav>

    <div class="mt-8 pt-8 border-t border-gray-200">
      <div class="flex space-x-4 justify-center">
        <a href="https://twitter.com/singh1aryan" class="text-gray-600 hover:text-primary-600">
          <span class="sr-only">Twitter</span>
          <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24">
            <path d="M8.29 20.251c7.547 0 11.675-6.253 11.675-11.675 0-.178 0-.355-.012-.53A8.348 8.348 0 0022 5.92a8.19 8.19 0 01-2.357.646 4.118 4.118 0 001.804-2.27 8.224 8.224 0 01-2.605.996 4.107 4.107 0 00-6.993 3.743 11.65 11.65 0 01-8.457-4.287 4.106 4.106 0 001.27 5.477A4.072 4.072 0 012.8 9.713v.052a4.105 4.105 0 003.292 4.022 4.095 4.095 0 01-1.853.07 4.108 4.108 0 003.834 2.85A8.233 8.233 0 012 18.407a11.616 11.616 0 006.29 1.84"></path>
          </svg>
        </a>
        <a href="https://linkedin.com/in/singh1aryan" class="text-gray-600 hover:text-primary-600">
          <span class="sr-only">LinkedIn</span>
          <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24">
            <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
          </svg>
        </a>
        <a href="https://instagram.com/singh.aryan.45" class="text-gray-600 hover:text-primary-600">
          <span class="sr-only">Instagram</span>
          <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</aside>

<button
  id="sidebar-toggle"
  class="fixed md:hidden bottom-4 right-4 bg-primary-600 text-white p-3 rounded-full shadow-lg z-50"
>
  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"/>
  </svg>
</button>

<script>
  import { animate } from 'motion';

  // Handle category expansion/collapse
  document.querySelectorAll('[data-category]').forEach(button => {
    button.addEventListener('click', () => {
      const svg = button.querySelector('svg');
      const list = button.nextElementSibling;
      
      if (list.style.display === 'none') {
        list.style.display = 'block';
        animate(svg, { rotate: 180 }, { duration: 0.2 });
      } else {
        list.style.display = 'none';
        animate(svg, { rotate: 0 }, { duration: 0.2 });
      }
    });
  });

  // Handle search functionality
  const searchInput = document.querySelector('input[type="search"]');
  searchInput.addEventListener('input', (e) => {
    const query = e.target.value.toLowerCase();
    document.querySelectorAll('a[href^="/blog/"]').forEach(link => {
      const title = link.textContent.toLowerCase();
      link.parentElement.style.display = title.includes(query) ? 'block' : 'none';
    });
  });

  // Mobile sidebar toggle
  const sidebar = document.getElementById('sidebar');
  const sidebarToggle = document.getElementById('sidebar-toggle');

  sidebarToggle.addEventListener('click', () => {
    const isOpen = sidebar.classList.contains('translate-x-0');
    
    if (isOpen) {
      sidebar.classList.remove('translate-x-0');
      sidebar.classList.add('-translate-x-full');
    } else {
      sidebar.classList.remove('-translate-x-full');
      sidebar.classList.add('translate-x-0');
    }
  });
</script>