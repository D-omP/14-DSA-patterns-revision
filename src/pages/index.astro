};

const patterns = [
  {
    title: "Two Pointers",
    description: "Master the art of solving array problems with two pointers technique",
    problems: 15,
    difficulty: "Easy/Medium"
  },
  {
    title: "Sliding Window",
    description: "Efficiently process arrays/strings with sliding window pattern",
    problems: 12,
    difficulty: "Medium"
  },
  {
