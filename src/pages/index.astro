---

<Layout 
  title="Build SaaS with AI - Complete Course"
  description="Learn to build profitable SaaS products with AI in days, not months. Complete course by Ex-Google Engineer."
>
  <div class="max-w-7xl mx-auto">
    <!-- Hero Section -->
    <div class="text-center mb-16">
      <span class="inline-flex items-center px-4 py-1.5 rounded-full text-sm font-medium bg-primary-100 text-primary-800">
        Limited Time Offer - 50% OFF
      </span>
      <h1 class="mt-6 text-4xl sm:text-5xl lg:text-6xl font-bold text-gray-900 leading-tight">
        Build & Launch Your SaaS <br class="hidden sm:block" />
        <span class="text-primary-600">10x Faster with AI</span>
      </h1>
      <p class="mt-6 text-xl sm:text-2xl text-gray-600 max-w-3xl mx-auto">
        Learn how to leverage AI to build profitable SaaS products in days, not months. 
        A complete course for developers who want to ship faster.
      </p>
      <div class="mt-8 flex justify-center gap-4">
        <a 
          href="#pricing" 
          class="inline-flex items-center px-8 py-4 rounded-lg bg-primary-600 text-white font-medium hover:bg-primary-700 transition-colors"
        >
          Get Started Now
          <svg class="ml-2 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
        <a 
          href="#curriculum" 
          class="inline-flex items-center px-8 py-4 rounded-lg bg-white text-primary-600 font-medium border-2 border-primary-600 hover:bg-primary-50 transition-colors"
        >
          View Curriculum
        </a>
      </div>
      <div class="mt-8 flex justify-center items-center gap-8 text-sm text-gray-500">
        {['Lifetime Access', '30-Day Money Back', 'Community Access'].map(item => (
          <span class="flex items-center">
            <svg class="w-5 h-5 mr-2 text-green-500" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
            {item}
          </span>
        ))}
      </div>
    </div>

    <!-- Projects Section -->
    <div class="mb-20">
      <h2 class="text-3xl font-bold text-center mb-12">What You'll Build</h2>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {features.map(feature => (
          <div class="bg-white rounded-xl shadow-md hover:shadow-lg transition-shadow p-6">
            <h3 class="text-xl font-semibold mb-2">{feature.title}</h3>
            <p class="text-gray-600 mb-4">{feature.description}</p>
            <div class="flex flex-wrap gap-2">
              {feature.tech.map(tech => (
                <span class="px-2 py-1 bg-gray-100 text-sm rounded">{tech}</span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Course Modules -->
    <div class="mb-20">
      <h2 class="text-3xl font-bold text-center mb-12">Course Curriculum</h2>
      <div class="max-w-3xl mx-auto space-y-6">
        {modules.map(module => (
          <div class="bg-white rounded-lg p-6 shadow-sm">
            <h3 class="text-xl font-semibold mb-4">{module.title}</h3>
            <ul class="space-y-3 text-gray-600">
              {module.items.map(item => (
                <li class="flex items-center">
                  <svg class="w-5 h-5 mr-3 text-green-500" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                  </svg>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>

    <!-- CTA Section -->
    <section class="text-center bg-primary-50 rounded-2xl p-8 mb-16">
      <h2 class="text-3xl font-bold text-gray-900 mb-4">Start Building Today</h2>
      <p class="text-xl text-gray-600 mb-8">
        Join hundreds of developers who are already building AI-powered SaaS products
      </p>
      <a 
        href="#pricing" 
        class="inline-flex items-center px-8 py-4 bg-primary-600 text-white rounded-lg hover:bg-primary-700 transition-colors text-lg font-medium"
      >
        Get Started Now
      </a>
    </section>
  </div>
</Layout>