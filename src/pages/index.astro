---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const features = [
  {
    title: "AI-Powered SaaS Dashboard",
    description: "Build a complete admin dashboard with AI-powered analytics, user management, and real-time insights.",
    tech: ["Next.js", "OpenAI", "Prisma"]
  },
  {
    title: "AI Content Generator",
    description: "Create a SaaS that generates SEO-optimized content, social media posts, and marketing copy using AI.",
    tech: ["React", "GPT-4", "MongoDB"]
  },
  {
    title: "AI Task Manager",
    description: "Develop a smart task management system that uses AI to prioritize and categorize tasks.",
    tech: ["Vue.js", "Node.js", "PostgreSQL"]
  }
];

const courseModules = [
  {
    number: "1",
    title: "Two Pointer Pattern",
    description: "Master efficient array manipulation with two pointers",
    lessons: [
      {
        title: "Core Concepts",
        topics: [
          "Two pointer technique fundamentals",
          "When to use two pointers",
          "Common variations and templates"
        ]
      },
      {
        title: "Problem Solving",
        topics: [
          "Two Sum variations",
          "Three Sum problems",
          "Sliding window vs Two pointers"
        ]
      }
    ]
  },
  {
    number: "2",
    title: "Sliding Window",
    description: "Solve substring and subarray problems efficiently",
    lessons: [
      {
        title: "Window Technique",
        topics: [
          "Fixed vs Dynamic windows",
          "Window size manipulation",
          "Optimization techniques"
        ]
      },
      {
        title: "Common Applications",
        topics: [
          "Maximum sum subarrays",
          "String pattern matching",
          "Minimum window substring"
        ]
      }
    ]
  },
  {
    number: "3",
    title: "Fast & Slow Pointers",
    description: "Detect cycles and find middle elements",
    lessons: [
      {
        title: "Floyd's Algorithm",
        topics: [
          "Cycle detection in arrays",
          "Linked list cycles",
          "Finding cycle start"
        ]
      },
      {
        title: "Pattern Applications",
        topics: [
          "Middle of linked list",
          "Happy number problem",
          "Palindrome linked list"
        ]
      }
    ]
  },
  {
    number: "4",
    title: "Merge Intervals",
    description: "Handle interval-based problems effectively",
    lessons: [
      {
        title: "Interval Basics",
        topics: [
          "Sorting intervals",
          "Overlapping detection",
          "Interval merging logic"
        ]
      },
      {
        title: "Advanced Topics",
        topics: [
          "Meeting rooms problems",
          "Insert interval variations",
          "Interval list intersections"
        ]
      }
    ]
  },
  {
    number: "5",
    title: "Cyclic Sort",
    description: "Optimize sorting for numbers in range",
    lessons: [
      {
        title: "Pattern Recognition",
        topics: [
          "When to use cyclic sort",
          "Array number properties",
          "In-place sorting technique"
        ]
      },
      {
        title: "Problem Types",
        topics: [
          "Missing number variations",
          "Duplicate number finding",
          "Array permutations"
        ]
      }
    ]
  },
  {
    number: "6",
    title: "In-place Reversal",
    description: "Reverse linked lists with O(1) space",
    lessons: [
      {
        title: "Reversal Technique",
        topics: [
          "Basic list reversal",
          "Partial list reversal",
          "Memory optimization"
        ]
      },
      {
        title: "Advanced Problems",
        topics: [
          "K groups reversal",
          "Alternating reversal",
          "Sublist reversal"
        ]
      }
    ]
  },
  {
    number: "7",
    title: "Tree BFS",
    description: "Level-order tree traversal patterns",
    lessons: [
      {
        title: "BFS Fundamentals",
        topics: [
          "Queue-based traversal",
          "Level tracking",
          "Node connections"
        ]
      },
      {
        title: "Common Problems",
        topics: [
          "Level averages",
          "Zigzag traversal",
          "Level order successor"
        ]
      }
    ]
  },
  {
    number: "8",
    title: "Tree DFS",
    description: "Solve tree problems using recursion",
    lessons: [
      {
        title: "DFS Patterns",
        topics: [
          "Preorder traversal",
          "Inorder traversal",
          "Postorder traversal"
        ]
      },
      {
        title: "Path Problems",
        topics: [
          "Path sum variations",
          "Tree diameter",
          "Binary tree paths"
        ]
      }
    ]
  },
  {
    number: "9",
    title: "Two Heaps",
    description: "Manage data streams with dual heaps",
    lessons: [
      {
        title: "Heap Basics",
        topics: [
          "Max-heap vs Min-heap",
          "Median maintenance",
          "Stream processing"
        ]
      },
      {
        title: "Applications",
        topics: [
          "Find median from stream",
          "Schedule tasks",
          "Interval scheduling"
        ]
      }
    ]
  },
  {
    number: "10",
    title: "Subsets",
    description: "Generate combinations and permutations",
    lessons: [
      {
        title: "Subset Pattern",
        topics: [
          "Iterative generation",
          "Recursive approach",
          "Duplicate handling"
        ]
      },
      {
        title: "Variations",
        topics: [
          "Permutations",
          "Combinations",
          "String permutations"
        ]
      }
    ]
  },
  {
    number: "11",
    title: "Modified Binary Search",
    description: "Advanced binary search variations",
    lessons: [
      {
        title: "Search Patterns",
        topics: [
          "Order-agnostic search",
          "Rotated array search",
          "Bitonic array search"
        ]
      },
      {
        title: "Complex Problems",
        topics: [
          "Search range",
          "Search insert position",
          "Peak element"
        ]
      }
    ]
  },
  {
    number: "12",
    title: "Greedy Algorithms",
    description: "Make locally optimal choices",
    lessons: [
      {
        title: "Greedy Approach",
        topics: [
          "Optimal substructure",
          "Greedy choice property",
          "Solution building"
        ]
      },
      {
        title: "Classic Problems",
        topics: [
          "Activity selection",
          "Fractional knapsack",
          "Huffman coding"
        ]
      }
    ]
  },
  {
    number: "13",
    title: "Backtracking",
    description: "Systematic solution search with pruning",
    lessons: [
      {
        title: "Core Concepts",
        topics: [
          "State space tree",
          "Constraint satisfaction",
          "Pruning techniques"
        ]
      },
      {
        title: "Famous Problems",
        topics: [
          "N-Queens",
          "Sudoku solver",
          "Word search"
        ]
      }
    ]
  },
  {
    number: "14",
    title: "Dynamic Programming",
    description: "Optimize solutions with memoization",
    lessons: [
      {
        title: "DP Fundamentals",
        topics: [
          "Optimal substructure",
          "State definition",
          "Memoization technique"
        ]
      },
      {
        title: "Common Patterns",
        topics: [
          "0/1 Knapsack",
          "Longest sequences",
          "Grid traversal"
        ]
      }
    ]
  }
];

// Get course posts for the sidebar
const coursePosts = await getCollection('course');
const sortedPosts = coursePosts.sort((a, b) => {
  if (a.data.priority !== b.data.priority) {
    return a.data.priority - b.data.priority;
  }
  return new Date(a.data.pubDate).getTime() - new Date(b.data.pubDate).getTime();
});

// Group posts by category
const postsByCategory = sortedPosts.reduce((acc, post) => {
  const category = post.data.category;
  if (!acc[category]) {
    acc[category] = [];
  }
  acc[category].push(post);
  return acc;
}, {});

// Get current path for active state
const currentPath = Astro.url.pathname;

// Add state for mobile menu
const isMobileMenuOpen = false;

// SEO metadata
const seoMetadata = {
  title: "14DSA - Master the Only 14 DSA Patterns You Need",
  description: "Master the essential 14 DSA patterns to crack coding interviews at FAANG companies. Structured learning path with hand-picked problems and detailed solutions.",
  keywords: [
    "dsa patterns",
    "coding interview prep",
    "faang interview",
    "data structures",
    "algorithms",
    "leetcode patterns",
    "interview preparation",
    "coding patterns",
    "algorithm patterns",
    "technical interview",
    "coding challenges",
    "programming interviews",
    "dsa course",
    "interview questions",
    "problem solving"
  ].join(", "),
  ogImage: "https://14dsa.com/og-image.png",
  twitterHandle: "@14dsa",
  siteUrl: "https://14dsa.com"
};

---

<Layout title={seoMetadata.title} description={seoMetadata.description}>
  <main class="w-full pb-4 px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto">
      <!-- Hero Section -->
      <div class="text-center px-4 sm:px-6 lg:px-8">
        <!-- Launch Badge -->
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full text-sm font-medium bg-gradient-to-r from-primary-500 to-primary-600 text-white mb-6 animate-bounce">
          <span class="flex h-2 w-2 relative">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-white opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-white"></span>
            </span>
          Just Launched 🚀
        </div>

        <!-- Mobile-optimized heading -->
        <h1 class="mt-6 text-4xl sm:text-5xl font-bold text-gray-900 leading-tight">
          <span class="block mb-2">Crack FAANG with</span>
          <span class="relative inline-block px-2 text-primary-600">
            14 DSA Patterns
            <div class="absolute inset-x-0 bottom-0 h-3 bg-primary-100 -z-10 transform -rotate-1"></div>
              </span>
            </h1>

        <!-- Mobile-optimized subheading -->
        <div class="mt-6 space-y-4">
          <p class="text-lg sm:text-xl text-gray-600 max-w-3xl mx-auto">
            <span class="font-semibold text-gray-800">Stop solving random problems.</span> Master the patterns that appear in 
            <span class="font-semibold text-primary-600">90% of FAANG interviews</span>
          </p>
          
          <!-- Quick Stats - Mobile Optimized -->
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 mt-8 max-w-lg mx-auto">
            <div class="bg-white rounded-xl p-3 shadow-sm border border-gray-100">
              <div class="text-2xl font-bold text-primary-600">14</div>
              <div class="text-sm text-gray-600">Core Patterns</div>
            </div>
            <div class="bg-white rounded-xl p-3 shadow-sm border border-gray-100">
              <div class="text-2xl font-bold text-green-600">100+</div>
              <div class="text-sm text-gray-600">Practice Problems</div>
            </div>
            <div class="col-span-2 sm:col-span-1 bg-white rounded-xl p-3 shadow-sm border border-gray-100">
              <div class="text-2xl font-bold text-blue-600">500+</div>
              <div class="text-sm text-gray-600">Success Stories</div>
            </div>
          </div>

          <!-- Trust Indicators -->
          <div class="flex flex-wrap justify-center items-center gap-4 mt-8">
            <div class="flex items-center gap-1 bg-yellow-50 px-3 py-1 rounded-full">
              <svg class="w-4 h-4 text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118l-2.8-2.034c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
              <span class="text-sm font-medium">4.9/5 Rating</span>
            </div>
            <div class="flex items-center gap-1 bg-green-50 px-3 py-1 rounded-full">
              <svg class="w-4 h-4 text-green-500" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                </svg>
              <span class="text-sm font-medium">FAANG Tested</span>
            </div>
          </div>
            </div>

        <!-- CTA Buttons - Mobile Optimized -->
        <div class="mt-8 flex flex-col gap-4 px-4">
          <a 
            href="/course/two-pointer" 
            class="w-full py-4 px-6 rounded-lg bg-primary-600 text-white font-medium hover:bg-primary-700 transition-all transform hover:scale-105 shadow-lg hover:shadow-xl flex items-center justify-center gap-2"
          >
            Start Learning Free
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
          <a 
            href="#patterns" 
            class="w-full py-4 px-6 rounded-lg bg-gray-100 text-gray-700 font-medium hover:bg-gray-200 transition-all flex items-center justify-center gap-2"
          >
            Explore All Patterns
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </a>
        </div>

      <!-- Pattern List Section -->
      <section id="patterns" class="mt-12">
        <div class="text-center mb-16">
          <span class="text-sm font-semibold text-primary-600 tracking-wide uppercase font-mono">
            14 Essential Patterns
          </span>
          <h2 class="mt-2 text-4xl font-bold text-gray-900 font-display">
            Master the Core 
            <span class="relative inline-block px-2">
              Interview Patterns
              <div class="absolute inset-x-0 bottom-0 h-3 bg-primary-100 -z-10 transform -rotate-1"></div>
            </span>
          </h2>
          <p class="mt-4 text-xl text-gray-600 max-w-3xl mx-auto">
            A structured approach to mastering the patterns that appear in 90% of FAANG interview questions
          </p>

          <!-- Course Stats -->
          <div class="mt-8 flex flex-wrap justify-center gap-8">
              <div class="flex items-center gap-2">
              <svg class="w-5 h-5 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
              </svg>
              <span>14 Core Patterns</span>
              </div>
            <div class="flex items-center gap-2">
              <svg class="w-5 h-5 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
              </svg>
              <span>100+ Practice Problems</span>
            </div>
            <div class="flex items-center gap-2">
              <svg class="w-5 h-5 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
                </svg>
              <span>FAANG-Style Solutions</span>
            </div>
          </div>
        </div>

        <div class="space-y-8 md:space-y-12">
          {courseModules.map((module, index) => (
            <div class="bg-white rounded-2xl shadow-lg hover:shadow-xl transition-all duration-300 p-6 md:p-8 relative overflow-hidden group">
              {/* Animated gradient background on hover */}
              <div class="absolute inset-0 bg-gradient-to-r from-primary-50 to-primary-100 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>

              {/* Module content */}
              <div class="relative">
                {/* Module number badge */}
                <div class="absolute -top-3 -left-3 w-16 h-16">
                  <div class="absolute inset-0 bg-primary-600 transform rotate-12 rounded"></div>
                  <div class="absolute inset-0 flex items-center justify-center text-white font-bold text-xl">
                    {module.number}
      </div>
                </div>

                <div class="pl-16">
                  <div class="flex items-center gap-4 mb-4">
                    <h3 class="text-2xl font-bold text-gray-900">
                      {module.title}
                    </h3>
                    {index === 0 && (
                      <span class="px-3 py-1 text-xs font-medium bg-green-100 text-green-800 rounded-full">
                        Start Here
                      </span>
                    )}
                    {index === courseModules.length - 1 && (
                      <span class="px-3 py-1 text-xs font-medium bg-blue-100 text-blue-800 rounded-full">
                        Final Project
                  </span>
                )}
                </div>
                  <p class="text-gray-600 mb-6">{module.description}</p>

                  {/* Lessons grid with adjusted spacing */}
                  <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4 ml-2">
                    {module.lessons.map((lesson) => (
                      <div class="bg-white rounded-xl border border-gray-100 p-4 hover:border-primary-200 transition-colors">
                        <h4 class="font-semibold text-gray-900 mb-3 flex items-center gap-2">
                          <svg class="w-5 h-5 text-primary-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                          </svg>
                          {lesson.title}
                        </h4>
                        <ul class="space-y-2">
                          {lesson.topics.map((topic) => (
                            <li class="flex items-start gap-2 text-sm text-gray-600">
                              <svg class="w-4 h-4 text-green-500 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                      </svg>
                              {topic}
                    </li>
                  ))}
                </ul>
                      </div>
                    ))}
                  </div>
                </div>
              </div>

              {/* Progress indicator */}
              <div class="absolute left-0 top-0 bottom-0 w-1 bg-primary-100">
                <div class="w-full bg-primary-500 transition-all duration-300" style={`height: ${(index + 1) * (100 / courseModules.length)}%`}></div>
              </div>
            </div>
          ))}
      </div>

        {/* Value Props */}
        <div class="mt-16 grid md:grid-cols-3 gap-8 text-center">
                <div class="p-6">
            <div class="w-12 h-12 bg-green-100 rounded-lg flex items-center justify-center mx-auto mb-4">
              <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div>
            <h3 class="text-lg font-semibold mb-2">Pattern Recognition</h3>
            <p class="text-gray-600">Learn to identify and apply the right pattern for any coding problem.</p>
          </div>
          <div class="p-6">
            <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center mx-auto mb-4">
              <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8h2a2 2 0 012 2v6a2 2 0 01-2 2h-2v4l-4-4H9a1.994 1.994 0 01-1.414-.586m0 0L11 14h4a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2v4l.586-.586z" />
              </svg>
            </div>
            <h3 class="text-lg font-semibold mb-2">Interview Strategies</h3>
            <p class="text-gray-600">Master proven techniques to solve problems under pressure.</p>
          </div>
          <div class="p-6">
            <div class="w-12 h-12 bg-yellow-100 rounded-lg flex items-center justify-center mx-auto mb-4">
              <svg class="w-6 h-6 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
            </div>
            <h3 class="text-lg font-semibold mb-2">Structured Learning</h3>
            <p class="text-gray-600">Follow a proven roadmap from basics to advanced patterns.</p>
          </div>
        </div>

        {/* CTA */}
        <div class="mt-16 text-center">
          <div class="inline-flex items-center px-4 py-2 rounded-full text-sm font-medium bg-primary-100 text-primary-800 mb-4">
            <svg class="w-4 h-4 mr-1.5" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-11a1 1 0 10-2 0v3.586L7.707 9.293a1 1 0 00-1.414 1.414l3 3a1 1 0 001.414 0l3-3a1 1 0 00-1.414-1.414L11 10.586V7z" clip-rule="evenodd" />
            </svg>
            Start Learning Today
          </div>
          <h3 class="text-3xl font-bold mb-4">Ready to Master DSA?</h3>
          <p class="text-xl text-gray-600 mb-8">Join 1000+ engineers who cracked FAANG interviews using our patterns</p>
          <a 
            href="/course/two-pointer" 
            class="inline-flex items-center px-8 py-4 text-lg font-medium text-white bg-primary-600 rounded-lg hover:bg-primary-700 transition-colors"
          >
            Start Free Trial
          </a>
        </div>
      </section>
      </div>
  </main>
</Layout>

<style>
  /* Hide scrollbar for Chrome, Safari and Opera */
  aside::-webkit-scrollbar {
    display: none;
  }

  /* Hide scrollbar for IE, Edge and Firefox */
  aside {
    -ms-overflow-style: none;  /* IE and Edge */
    scrollbar-width: none;  /* Firefox */
  }

  /* Add smooth transitions */
  #course-sidebar {
    transition: transform 0.2s ease-in-out;
  }

  #sidebar-overlay {
    transition: opacity 0.2s ease-in-out;
  }

  /* Show sidebar when open class is added */
  #course-sidebar.open {
    transform: translateX(0);
  }

  /* Show overlay when open */
  #sidebar-overlay.open {
    display: block;
  }

  /* Smooth scrolling for lesson cards */
  .snap-x {
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none; /* Firefox */
  }
  
  .snap-x::-webkit-scrollbar {
    display: none; /* Chrome, Safari, Opera */
  }
</style>

<script>
  // Mobile menu functionality
  const mobileMenuButton = document.getElementById('mobile-menu-button');
  const sidebar = document.getElementById('course-sidebar');
  const overlay = document.getElementById('sidebar-overlay');
  const menuIcon = document.getElementById('menu-icon');
  const closeIcon = document.getElementById('close-icon');

  function toggleMenu() {
    sidebar?.classList.toggle('open');
    overlay?.classList.toggle('open');
    menuIcon?.classList.toggle('hidden');
    closeIcon?.classList.toggle('hidden');
  }

  // Toggle menu when button is clicked
  mobileMenuButton?.addEventListener('click', toggleMenu);

  // Close menu when overlay is clicked
  overlay?.addEventListener('click', toggleMenu);

  // Close menu when escape key is pressed
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && sidebar?.classList.contains('open')) {
      toggleMenu();
    }
  });

  // Close menu when window is resized to desktop size
  window.addEventListener('resize', () => {
    if (window.innerWidth >= 768 && sidebar?.classList.contains('open')) {
      toggleMenu();
    }
  });

  // Handle mobile scroll behavior
  let lastScroll = 0;
  const mobileNav = document.getElementById('mobile-menu-button');

  window.addEventListener('scroll', () => {
    if (!mobileNav) return;
    
    const currentScroll = window.pageYOffset;
    
    if (currentScroll <= 0) {
      mobileNav.classList.remove('translate-y-full');
      return;
    }
    
    if (currentScroll > lastScroll && !mobileNav.classList.contains('translate-y-full')) {
      // Scrolling down
      mobileNav.classList.add('translate-y-full');
    } else if (currentScroll < lastScroll && mobileNav.classList.contains('translate-y-full')) {
      // Scrolling up
      mobileNav.classList.remove('translate-y-full');
    }
    
    lastScroll = currentScroll;
  });
</script> 