---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
const recentPosts = posts
  .sort((a, b) => {
    // Handle potential undefined or invalid dates
    const dateA = a.data.pubDate instanceof Date ? a.data.pubDate : new Date(a.data.pubDate);
    const dateB = b.data.pubDate instanceof Date ? b.data.pubDate : new Date(b.data.pubDate);
    return dateB.getTime() - dateA.getTime();
  })
  .slice(0, 7);

const projects = [
        {
          category: "Featured Projects",
          projects: [
            {
              title: "Skillset Master",
              url: "https://skillsetmaster.com",
              description: "Level up with trending skills",
              status: "launched"
            },
            {
              title: "Simple investings",
              url: "https://simpleinvestings.com",
              description: "Simple investing for beginners",
              status: "launched"
            }, 
            {
              title: "Immigrant Job Help",
              url: "https://immigrantjobhelp.com",
              description: "Job search for immigrants",
              status: "launched"
            },
      {
        title: "Coder Aryan",
        url: "https://coderaryan.com",
        description: "Personal blog where I share everything",
        status: "launched"
      }, 
      {
        title: "My Instagram Page",
        url: "https://instagram.com/singh.aryan.45",
        description: "450k+ followers on Instagram",
        status: "launched"
      },
      {
        title: "My YouTube Channel",
        url: "https://www.youtube.com/@singh1aryan",
        description: "Tech tutorials and career guidance",
        status: "launched"
      }
          ]
        },
        {
          category: "In Progress",
          projects: [
            {
              title: "Build in minutes",
              url: "https://buildinminutes.com",
              description: "Build any app in minutes",
              status: "in-progress"
            }, 
            {
              title: "Baby SaaS",
              url: "https://babysaas.com",
              description: "Build your own SaaS in minutes",
              status: "in-progress"
            }, 
            {
              title: "Get AI News",
              url: "https://getainews.com",
              description: "Stay updated with AI developments",
              status: "in-progress"
            }, 
            {
              title: "Get Startup News",
              url: "https://getstartupnews.com",
              description: "Latest in the startup ecosystem",
              status: "in-progress"
            }, 
            {
              title: "Career tools AI",
              url: "https://careertoolsai.com",
              description: "AI tools for your career",
              status: "in-progress"
            }, 
          ]
        },
      ];
---

<Layout title="Aryan Singh's Tech Blog">
  <div class="max-w-4xl mx-auto px-4 sm:px-6">
    <header class="mb-12">
      <div>
        <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-4">Aryan Singh</h1>
        <p class="text-lg sm:text-xl text-gray-600">
          Engineer, Creator, and Indie Hacker building products and sharing insights about Tech, AI, and Startups.
        </p>
      </div>
    </header>


    <section class="mb-12">
      <div class="flex justify-between items-center mb-6">
        <h2 class="text-2xl font-bold text-gray-900">Recent Blogs</h2>
        <a href="/blog" class="flex items-center gap-2 text-primary-600 hover:text-primary-700 transition-colors">
          All blogs
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
          </svg>
        </a>
      </div>
      <div class="space-y-4">
        {recentPosts.map(post => (
          <article class="group bg-white p-4 rounded-lg shadow-sm hover:shadow-md transition-all duration-200 border border-gray-100">
            <a href={`/blog/${post.slug}`} class="block">
              <h3 class="text-lg font-semibold text-gray-900 group-hover:text-primary-600 transition-colors">
                {post.data.title}
              </h3>
              <p class="text-gray-600 text-sm mt-1 mb-2 line-clamp-2">{post.data.description}</p>
              <div class="flex items-center text-xs">
                <span class="text-primary-600">{post.data.pubDate.toLocaleDateString()}</span>
                <span class="mx-2 text-gray-400">•</span>
                <span class="px-2 py-0.5 bg-primary-50 text-primary-700 rounded-full">
                  {post.data.category.replace('-', ' ').toUpperCase()}
                </span>
              </div>
            </a>
          </article>
        ))}
      </div>
    </section>

    <section class="mb-12">
      <h2 class="text-2xl font-bold text-gray-900 mb-6 border-b-2 border-primary-300 pb-2 inline-block">Currently working on</h2>
      
      {projects.map(section => (
        <div class="mb-8 last:mb-0">
          <h3 class="text-xl font-semibold text-gray-800 mb-4 pl-4 border-l-4 border-primary-400">
            {section.category}
          </h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6">
            {section.projects.map(project => (
              <a href={project.url} 
                 target="_blank" 
                 rel="noopener noreferrer"
                 class={`block p-6 bg-white rounded-lg border border-gray-200 shadow-sm 
                         hover:shadow-lg transition-all hover:-translate-y-1 
                         hover:border-primary-300 group
                         ${project.status === 'coming-soon' ? 'opacity-75 cursor-not-allowed' : ''}`}>
                <div class="flex justify-between items-start mb-2">
                  <h3 class="text-xl font-semibold text-gray-900 group-hover:text-primary-600">
                    {project.title}
                  </h3>
                  {project.status === 'launched' && 
                    <span class="text-xs px-2 py-1 bg-green-100 text-green-800 rounded-full">Launched</span>
                  }
                  {project.status === 'in-progress' && 
                    <span class="text-xs px-2 py-1 bg-yellow-100 text-yellow-800 rounded-full">In Progress</span>
                  }
                  {project.status === 'coming-soon' && 
                    <span class="text-xs px-2 py-1 bg-gray-100 text-gray-800 rounded-full">Coming Soon</span>
                  }
                </div>
                <p class="text-gray-600">{project.description}</p>
              </a>
            ))}
          </div>
        </div>
      ))}
    </section>

    <!-- <section class="mb-12 bg-gradient-to-br from-gray-50 to-gray-100 p-4 sm:p-8 rounded-xl border border-gray-200 shadow-sm">
      <h2 class="text-2xl font-bold text-gray-900 mb-4 border-b-2 border-primary-300 pb-2 inline-block">Background</h2>
      <div class="space-y-4">
        <p class="text-gray-700 flex items-center p-3 bg-white rounded-lg border-l-4 border-primary-400 shadow-sm">
          👨‍💻 Previously Software Engineer at Google and Arrow Electronics
        </p>
        <p class="text-gray-700 flex items-center p-3 bg-white rounded-lg border-l-4 border-primary-400 shadow-sm">
          🎓 Computer Science at UMass
        </p>
        <p class="text-gray-700 flex items-center p-3 bg-white rounded-lg border-l-4 border-primary-400 shadow-sm">
          🚀 Tech Educator with 600k+ social media following
        </p>
      </div>
    </section> -->


    <section class="bg-primary-50 p-4 sm:p-8 rounded-lg">
      <h2 class="text-2xl font-bold text-gray-900 mb-4">Newsletter</h2>
      <p class="text-gray-600 mb-6">
        Get weekly insights about Cloud Architecture, System Design, and Software Engineering best practices.
      </p>
      <form class="flex flex-col sm:flex-row gap-4">
        <input
          type="email"
          placeholder="Enter your email"
          class="flex-1 px-4 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-primary-500 focus:border-primary-500"
        />
        <button
          type="submit"
          class="px-6 py-2 bg-primary-600 text-white rounded-lg hover:bg-primary-700 transition-colors"
        >
          Subscribe
        </button>
      </form>
    </section>
  </div>
</Layout>