---

<Layout 
  title={seoMetadata.title}
  description={seoMetadata.description}
  ogImage={seoMetadata.ogImage}
  twitterHandle={seoMetadata.twitterHandle}
>
  <div class="flex flex-col min-h-screen bg-gray-50">
    <main class="flex-1">
      <!-- Hero Section -->
      <div class="relative overflow-hidden bg-gray-50">
        <div class="max-w-7xl mx-auto pt-16 pb-16 px-4 sm:px-6 lg:px-8">
          <div class="text-center">
            <span class="text-lg font-semibold text-primary-600 mb-4 block font-mono">
              The Only DSA Course You Need
            </span>
            <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-gray-900 tracking-tight font-display">
              Master the 14 Core
              <span class="block text-primary-600 mt-2">
                DSA Patterns
                <svg class="absolute w-full h-3 -bottom-2 left-0 text-primary-200" viewBox="0 0 300 12" fill="currentColor">
                  <path d="M3,7 Q150,0 297,7" stroke="currentColor" stroke-width="3" fill="none"/>
                </svg>
              </span>
            </h1>
            <p class="mt-8 text-xl text-gray-600 max-w-3xl mx-auto">
              Join 10,000+ developers who have mastered coding interviews using our pattern-based approach:
            </p>
            
            <!-- Feature Pills -->
            <div class="flex flex-wrap justify-center gap-4 mt-6">
              <span class="inline-flex items-center px-4 py-2 rounded-full text-sm font-medium bg-blue-50 text-blue-700">
                <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
                </svg>
                14 Core Patterns
              </span>
              <span class="inline-flex items-center px-4 py-2 rounded-full text-sm font-medium bg-green-50 text-green-700">
                <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
                </svg>
                100+ Hand-Picked Problems
              </span>
              <span class="inline-flex items-center px-4 py-2 rounded-full text-sm font-medium bg-purple-50 text-purple-700">
                <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 15l-2 5L9 9l11 4-5 2zm0 0l5 5M7.188 2.239l.777 2.897M5.136 7.965l-2.898-.777M13.95 4.05l-2.122 2.122m-5.657 5.656l-2.12 2.122" />
                </svg>
                Pattern Recognition
              </span>
            </div>

            <!-- CTA Button -->
            <div class="mt-12">
              <a 
                href="/course"
                class="inline-flex items-center px-8 py-4 bg-primary-600 text-white rounded-lg hover:bg-primary-700 transition-colors text-lg font-medium"
              >
                Start Learning
                <svg class="ml-2 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
                </svg>
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Patterns Grid -->
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold text-gray-900">The 14 Essential Patterns</h2>
          <p class="mt-4 text-xl text-gray-600">
            Master these patterns to solve any coding interview question
          </p>
        </div>
        
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
          {patterns.map(pattern => (
            <div class="bg-white rounded-xl shadow-md hover:shadow-xl transition-shadow p-6">
              <h3 class="text-xl font-bold text-gray-900 mb-2">{pattern.title}</h3>
              <p class="text-gray-600 mb-4">{pattern.description}</p>
              <div class="flex justify-between text-sm">
                <span class="text-primary-600">{pattern.problems} Problems</span>
                <span class="text-gray-500">{pattern.difficulty}</span>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Features Section -->
      <div class="bg-white py-16">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="text-center mb-12">
            <h2 class="text-3xl font-bold text-gray-900">Why Our Pattern-Based Approach Works</h2>
            <p class="mt-4 text-xl text-gray-600">
              Learn smarter, not harder with our proven methodology
            </p>
          </div>
          
          <div class="grid md:grid-cols-3 gap-8">
            {features.map(feature => (
              <div class="text-center">
                <div class="text-4xl mb-4">{feature.icon}</div>
                <h3 class="text-xl font-bold text-gray-900 mb-2">{feature.title}</h3>
                <p class="text-gray-600">{feature.description}</p>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- Testimonials Section -->
      <section class="bg-gradient-to-b from-white to-gray-50 pb-16">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="text-center mb-12">
            <span class="text-sm font-semibold text-primary-600 tracking-wide uppercase font-mono">Success Stories</span>
            <h2 class="mt-2 text-3xl font-bold text-gray-900 sm:text-4xl font-display">
              Trusted by
              <span class="relative inline-block px-2">
                Founders and Developers
                <div class="absolute inset-x-0 bottom-0 h-3 bg-blue-100 -z-10 transform -rotate-1"></div>
              </span>
            </h2>
            <p class="mt-4 text-xl text-gray-600">
              See how developers are building six-figure SaaS businesses with BabySaaS
            </p>
          </div>

          <!-- Testimonial Cards -->
          <div class="grid md:grid-cols-3 gap-8">
            {testimonials.map((testimonial) => (
              <div class="bg-white rounded-2xl shadow-lg p-8 relative">
                <!-- Company Logo -->
                <div class="absolute -top-6 right-8">
                  <div class="w-12 h-12 bg-white rounded-xl shadow-md flex items-center justify-center p-2">
                    <img 
                      src={testimonial.image} 
                      alt={testimonial.author} 
                      class="w-full h-full object-contain"
                    />
                  </div>
                </div>

                <!-- Rating Stars -->
                <div class="flex gap-1 mb-4">
                  {Array.from({ length: testimonial.rating }).map(() => (
                    <svg class="w-5 h-5 text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
                      <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                    </svg>
                  ))}
                </div>

                <!-- Testimonial Content -->
                <blockquote class="text-gray-600 mb-6">
                  "{testimonial.content}"
                </blockquote>

                <!-- Author Info -->
                <div class="flex items-center gap-4">
                  <img 
                    src={testimonial.image} 
                    alt={`Photo of ${testimonial.author}`}
                    class="w-12 h-12 rounded-full object-cover"
                    loading="lazy"
                  />
                  <div>
                    <div class="font-semibold text-gray-900">{testimonial.author}</div>
                    <div class="text-sm text-gray-600">{testimonial.role}</div>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

  </div>
</Layout>

<style>
  /* Reset margins and paddings */
  :global(body) {
    margin: 0;
    padding: 0;
  }

  main {
    display: block;
    margin: 0;
    padding: 0;
  }

  section {
    margin: 0;
    padding: 4rem 0;
  }

  @media (max-width: 768px) {
    section {
      padding: 3rem 0;
    }
  }

  footer {
    margin: 0;
  }
</style>