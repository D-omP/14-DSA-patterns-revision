---

<Layout title="BabySaaS - Build Better SaaS Products">
  <div class="flex flex-col min-h-screen bg-gray-50">
    <main class="flex-1">
      <!-- Hero Section -->
      <div class="relative overflow-hidden bg-gray-50">
        <div class="max-w-7xl mx-auto pt-16 pb-16 px-4 sm:px-6 lg:px-8">
          <div class="text-center">
            <span class="text-lg font-semibold text-primary-600 mb-4 block font-mono">
              The Ultimate SaaS Development Platform
            </span>
            <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-gray-900 tracking-tight font-display">
              Build AI-Powered SaaS
              <span class="block text-primary-600 mt-2 relative">
                10x Faster
                <svg class="absolute w-full h-3 -bottom-2 left-0 text-primary-200" viewBox="0 0 300 12" fill="currentColor">
                  <path d="M3,7 Q150,0 297,7" stroke="currentColor" stroke-width="3" fill="none"/>
                </svg>
              </span>
            </h1>
            <p class="mt-8 text-xl text-gray-600 max-w-3xl mx-auto">
              Join 500+ developers who have already launched successful SaaS products using our battle-tested templates and courses
            </p>
          </div>
        </div>
        <div class="absolute bottom-0 inset-x-0 h-24 bg-gradient-to-t from-white"></div>
      </div>

      <!-- Showcase Section -->
      <section class="bg-gradient-to-b from-gray-50 to-white py-16">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="text-center mb-12">
            <span class="text-sm font-semibold text-primary-600 tracking-wide uppercase font-mono">Endless Possibilities</span>
            <h2 class="mt-2 text-3xl font-bold text-gray-900 sm:text-4xl font-display">
              Transform Your Ideas Into 
              <span class="relative inline-block px-2">
                Reality
                <div class="absolute inset-x-0 bottom-0 h-3 bg-primary-100 -z-10 transform -rotate-2"></div>
              </span>
            </h2>
            <p class="mt-4 text-xl text-gray-600">
              From AI content generators to analytics dashboards — build anything you can imagine
            </p>
          </div>

          <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
            {showcaseApps.map(app => (
              <div class="group relative bg-white rounded-2xl shadow-md hover:shadow-xl transition-shadow overflow-hidden">
                <div class="aspect-w-16 aspect-h-9 bg-gray-200">
                  <img 
                    src={app.image} 
                    alt={app.title}
                    class="object-cover"
                  />
                </div>
                <div class="p-6">
                  <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-primary-50 text-primary-700">
                    {app.category}
                  </span>
                  <h3 class="mt-4 text-xl font-bold text-gray-900">
                    {app.title}
                  </h3>
                  <p class="mt-2 text-gray-600">
                    {app.description}
                  </p>
                  <div class="mt-4 flex flex-wrap gap-2">
                    {app.tags.map(tag => (
                      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
                        {tag}
                      </span>
                    ))}
                  </div>
                  <a 
                    href={app.demoUrl}
                    class="mt-6 inline-flex items-center text-primary-600 hover:text-primary-700"
                  >
                    View Demo
                    <svg class="ml-2 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                    </svg>
                  </a>
                </div>
              </div>
            ))}
          </div>

          <div class="text-center mt-16">
            <a 
              href="/templates"
              class="inline-flex items-center px-8 py-4 bg-primary-600 text-white rounded-lg hover:bg-primary-700 transition-colors text-lg font-medium"
            >
              View All Templates
              <svg class="ml-2 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </a>
          </div>
        </div>
      </section>

      <!-- Add this section just before the Products Grid -->
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-primary-50 text-primary-700 font-mono">
            🚀 Launch Faster
          </span>
          <h2 class="mt-4 text-3xl font-bold text-gray-900 sm:text-4xl font-display">
            Your Fast Track to 
            <span class="relative inline-block">
              Success
              <div class="absolute inset-x-0 bottom-0 h-3 bg-yellow-100 -z-10"></div>
            </span>
          </h2>
          <p class="mt-4 text-xl text-gray-600 max-w-3xl mx-auto">
            Skip months of development. Get battle-tested templates and expert guidance to launch your SaaS in days, not months.
          </p>
        </div>
      </div>

      <!-- Products Grid -->
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
        <div class="grid md:grid-cols-3 gap-8">
          {products.map(product => (
            <div class="relative group">
              <div class="absolute -inset-0.5 bg-gradient-to-r {product.color} rounded-2xl blur opacity-25 group-hover:opacity-75 transition duration-200"></div>
              <div class="relative bg-white rounded-xl shadow-lg hover:shadow-xl transition-shadow p-8">
                {product.badge && (
                  <span class="absolute top-4 right-4 inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-primary-100 text-primary-800">
                    {product.badge}
                  </span>
                )}
                <div class="mb-6">
                  <h2 class="text-2xl font-bold text-gray-900 mb-2">{product.title}</h2>
                  <p class="text-gray-600">{product.description}</p>
                </div>
                <ul class="space-y-3 mb-8">
                  {product.features.map(feature => (
                    <li class="flex items-center text-gray-600">
                      <svg class="w-5 h-5 mr-2 text-green-500" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                      </svg>
                      {feature}
                    </li>
                  ))}
                </ul>
                <a 
                  href={product.url}
                  class="inline-flex items-center justify-center w-full px-6 py-3 text-base font-medium text-white bg-primary-600 hover:bg-primary-700 rounded-lg transition-colors"
                >
                  Learn More
                  <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
                  </svg>
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Why Choose Us Section -->
      <section class="bg-gray-50 py-16">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="text-center mb-12">
            <span class="text-sm font-semibold text-primary-600 tracking-wide uppercase font-mono">Why Developers Love Us</span>
            <h2 class="mt-2 text-3xl font-bold text-gray-900 sm:text-4xl font-display">
              Built Different, 
              <span class="relative inline-block px-2">
                Built Better
                <div class="absolute inset-x-0 bottom-0 h-3 bg-green-100 -z-10 transform rotate-1"></div>
              </span>
            </h2>
            <p class="mt-4 text-xl text-gray-600">
              Join the most developer-friendly platform for building modern SaaS products
            </p>
          </div>
          <div class="grid md:grid-cols-3 gap-12">
            <div class="text-center">
              <div class="w-16 h-16 bg-primary-100 rounded-2xl flex items-center justify-center mx-auto mb-6">
                <svg class="w-8 h-8 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                </svg>
              </div>
              <h3 class="text-xl font-semibold text-gray-900 mb-2">Lightning Fast Setup</h3>
              <p class="text-gray-600">Get your SaaS up and running in minutes, not months</p>
            </div>
            <div class="text-center">
              <div class="w-16 h-16 bg-primary-100 rounded-2xl flex items-center justify-center mx-auto mb-6">
                <svg class="w-8 h-8 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
                </svg>
              </div>
              <h3 class="text-xl font-semibold text-gray-900 mb-2">Production Ready</h3>
              <p class="text-gray-600">Enterprise-grade security and scalability built-in</p>
            </div>
            <div class="text-center">
              <div class="w-16 h-16 bg-primary-100 rounded-2xl flex items-center justify-center mx-auto mb-6">
                <svg class="w-8 h-8 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
                </svg>
              </div>
              <h3 class="text-xl font-semibold text-gray-900 mb-2">AI-Powered</h3>
              <p class="text-gray-600">Built-in AI capabilities to supercharge your SaaS</p>
            </div>
          </div>
        </div>
      </section>

      <!-- Testimonials Section -->
      <section class="bg-gradient-to-b from-white to-gray-50 py-16">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="text-center mb-12">
            <span class="text-sm font-semibold text-primary-600 tracking-wide uppercase font-mono">Success Stories</span>
            <h2 class="mt-2 text-3xl font-bold text-gray-900 sm:text-4xl font-display">
              Trusted by
              <span class="relative inline-block px-2">
                Industry Leaders
                <div class="absolute inset-x-0 bottom-0 h-3 bg-blue-100 -z-10 transform -rotate-1"></div>
              </span>
            </h2>
            <p class="mt-4 text-xl text-gray-600">
              See how developers are building six-figure SaaS businesses with BabySaaS
            </p>
          </div>

          <!-- Success Stats -->
          <div class="grid grid-cols-2 md:grid-cols-4 gap-8 mb-12">
            <div class="text-center">
              <div class="text-4xl font-bold text-primary-600 mb-2">500+</div>
              <div class="text-gray-600">Active Users</div>
            </div>
            <div class="text-center">
              <div class="text-4xl font-bold text-primary-600 mb-2">100+</div>
              <div class="text-gray-600">Products Launched</div>
            </div>
            <div class="text-center">
              <div class="text-4xl font-bold text-primary-600 mb-2">50M+</div>
              <div class="text-gray-600">API Requests</div>
            </div>
            <div class="text-center">
              <div class="text-4xl font-bold text-primary-600 mb-2">4.9/5</div>
              <div class="text-gray-600">Average Rating</div>
            </div>
          </div>

          <!-- Testimonial Cards -->
          <div class="grid md:grid-cols-3 gap-8">
            {testimonials.map((testimonial) => (
              <div class="bg-white rounded-2xl shadow-lg p-8 relative">
                <!-- Company Logo -->
                <div class="absolute -top-6 right-8">
                  <div class="w-12 h-12 bg-white rounded-xl shadow-md flex items-center justify-center p-2">
                    <img 
                      src={testimonial.logo} 
                      alt={testimonial.author} 
                      class="w-full h-full object-contain"
                    />
                  </div>
                </div>

                <!-- Rating Stars -->
                <div class="flex gap-1 mb-4">
                  {Array.from({ length: testimonial.rating }).map(() => (
                    <svg class="w-5 h-5 text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
                      <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                    </svg>
                  ))}
                </div>

                <!-- Testimonial Content -->
                <blockquote class="text-gray-600 mb-6">
                  "{testimonial.content}"
                </blockquote>

                <!-- Author Info -->
                <div class="flex items-center gap-4">
                  <img 
                    src={testimonial.image} 
                    alt={testimonial.author}
                    class="w-12 h-12 rounded-full object-cover"
                  />
                  <div>
                    <div class="font-semibold text-gray-900">{testimonial.author}</div>
                    <div class="text-sm text-gray-600">{testimonial.role}</div>
                  </div>
                </div>
              </div>
            ))}
