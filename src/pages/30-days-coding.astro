---
import Layout from '../layouts/Layout.astro';

// SEO metadata
const seoMetadata = {
  title: "30 Days Coding by Aryan Singh | Premium Coding Courses",
  description: "Join 10,000+ students learning coding with Aryan Singh's comprehensive course platform. Master programming with 1,500+ video lessons, real projects, and interview prep.",
  keywords: [
    "aryan singh course",
    "aryan singh 30dayscoding course",
    "30dayscoding course",
    "aryan singh 30dc",
    "coding bootcamp",
    "learn programming",
    "coding interview prep",
    "affordable coding course",
    "programming tutorials",
    "coding projects",
    "learn to code online",
    "web development course",
    "full stack development",
    "programming for beginners",
    "software engineering course",
    "data structures algorithms",
    "javascript course",
    "python programming",
    "coding interview preparation",
    "tech career guidance",
    "coding mentorship",
    "learn coding from scratch",
    "professional coding course",
    "coding career transition"
  ].join(", ")
};

const metrics = [
  { label: "Video Lessons", value: "1,500+" },
  { label: "Interview Questions", value: "250+" },
  { label: "Comprehensive Guides", value: "25+" },
  { label: "Active Students", value: "10,000+" }
];

const features = [
  {
    title: "Structured Learning Path",
    description: "From basics to advanced concepts, carefully crafted curriculum for optimal learning progression."
  },
  {
    title: "Real-world Projects",
    description: "Build practical projects that employers actually look for in candidates."
  },
  {
    title: "Interview Preparation",
    description: "Comprehensive interview prep with real questions from top tech companies."
  },
  {
    title: "Lifetime Access",
    description: "One-time payment for lifetime access to all content and future updates."
  }
];

const structuredData = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "Aryan Singh - 30 Days Coding",
  "description": "Premium, affordable coding courses for job-ready skills. Complete curriculum with 1,500+ video lessons.",
  "url": "https://30dayscoding.com",
  "brand": {
    "@type": "Brand",
    "name": "30 Days Coding"
  },
  "author": {
    "@type": "Person",
    "name": "Aryan Singh",
    "alumniOf": "Google"
  },
  "offers": {
    "@type": "Offer",
    "availability": "https://schema.org/InStock",
    "price": "49.99",
    "priceCurrency": "USD"
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.8",
    "reviewCount": "3000"
  }
};
---

<Layout
  title={seoMetadata.title}
  description={seoMetadata.description}
>
  <>
    <meta name="keywords" content={seoMetadata.keywords} />
    <meta name="author" content="Aryan Singh" />
    <meta property="og:title" content={seoMetadata.title} />
    <meta property="og:description" content={seoMetadata.description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://coderaryan.com/30-days-coding" />
    <meta property="og:image" content="https://coderaryan.com/images/30dc-og.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content="@singh_aryan_45" />
    <meta name="twitter:title" content={seoMetadata.title} />
    <meta name="twitter:description" content={seoMetadata.description} />
    <link rel="canonical" href="https://coderaryan.com/30-days-coding" />
  </>

  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-12">
    <header class="text-center mb-16">
      <h1 class="text-4xl font-bold text-gray-900 mb-4">The Story of 30 Days Coding</h1>
      <p class="text-xl text-gray-600 max-w-3xl mx-auto">
        From an idea to a thriving learning platform helping thousands master programming
      </p>
    </header>

    {/* Metrics Section */}
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6 mb-16">
      {metrics.map(metric => (
        <div class="text-center p-6 bg-white rounded-xl border border-gray-200 shadow-sm">
          <div class="text-3xl font-bold text-primary-600 mb-2">{metric.value}</div>
          <div class="text-gray-600">{metric.label}</div>
        </div>
      ))}
    </div>

    {/* Story Section */}
    <section class="prose prose-lg max-w-none mb-16">
      <h2>The Journey</h2>
      <p>
        My co-founder Deepanshu and I started 30 Days Coding with a simple mission: coding education needed 
        a major refresh. While there were many resources available, most were either too serious and boring, 
        or ridiculously expensive. We decided to create a platform where learning to code is fun, 
        project-driven, and actually affordable.
      </p>
      
      <p>
        Together, we created a unique learning approach: bite-sized, humorous video lessons combined with 
        hands-on projects that you'll actually want to show off. No more dry theory - we learn by building 
        cool stuff while having fun along the way. Our combined experience in mentoring developers helped us 
        design a curriculum that focuses on what actually matters in the industry.
      </p>

      <h2>The Impact</h2>
      <p>
        Today, 30 Days Coding has helped over 3,000 students transform their careers. Our students have landed 
        roles at companies like Google, Amazon, Microsoft, and countless startups. The platform has evolved from 
        a simple course website to a comprehensive learning ecosystem with:
      </p>

      <div class="grid md:grid-cols-2 gap-6 my-8">
        {features.map(feature => (
          <div class="p-6 border border-blue-500 bg-gray-50 rounded-xl hover:bg-white hover:shadow-lg transition-all duration-300 border border-gray-100 group">
            <h3 class="text-xl font-semibold text-gray-900 mb-3 group-hover:text-primary-600 transition-colors">{feature.title}</h3>
            <p class="text-gray-600 leading-relaxed">{feature.description}</p>
          </div>
        ))}
      </div>

      <h2>Looking Forward</h2>
      <p>
        The journey of 30 Days Coding continues as we keep expanding our curriculum and improving the learning 
        experience. Our mission remains unchanged: making quality coding education accessible to everyone who 
        wants to build a career in tech.
      </p>
    </section>

    {/* CTA Section */}
    <section class="text-center bg-primary-50 rounded-2xl p-8 mb-16">
      <h2 class="text-3xl font-bold text-gray-900 mb-4">Start Your Coding Journey Today</h2>
      <p class="text-xl text-gray-600 mb-8">
        Join thousands of successful students who have transformed their careers with 30 Days Coding
      </p>
      <a 
        href="https://30dayscoding.com"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center px-8 py-4 bg-primary-600 text-white rounded-lg hover:bg-primary-700 transition-colors text-lg font-medium"
      >
        Explore Courses
      </a>
    </section>
  </div>
</Layout> 