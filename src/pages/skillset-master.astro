---
import Layout from '../layouts/Layout.astro';

// SEO metadata
const seoMetadata = {
  title: "Skillset Master by Aryan Singh | Master In-Demand Skills",
  description: "Join thousands learning diverse skills with Aryan Singh's comprehensive learning platform. Master Digital Marketing, AI, Data Analytics, Video Editing, and more with practical courses.",
  keywords: [
    "aryan singh skillset master",
    "skillset master course",
    "aryan singh courses",
    "digital marketing courses",
    "ai learning platform",
    "data analytics training",
    "video editing courses",
    "study abroad guidance",
    "linkedin optimization",
    "productivity courses",
    "professional development",
    "career advancement courses",
    "digital skills learning",
    "technology courses",
    "skill development platform",
    "online learning platform",
    "career guidance",
    "professional certification",
    "practical skill courses",
    "hands-on learning"
  ].join(", ")
};

const metrics = [
  { label: "Skills Covered", value: "25+" },
  { label: "Practice Projects", value: "100+" },
  { label: "Success Stories", value: "1,000+" },
  { label: "Industry Partners", value: "50+" }
];

const features = [
  {
    title: "Diverse Skill Categories",
    description: "Master essential skills across Digital Marketing, AI, Data Analytics, Video Editing, Study Abroad prep, LinkedIn optimization, and Productivity."
  },
  {
    title: "Expert-Led Training",
    description: "Learn from industry professionals who bring real-world experience in their respective domains."
  },
  {
    title: "Practical Application",
    description: "Apply your learning through hands-on projects and real-world case studies in your chosen field."
  },
  {
    title: "Career Enhancement",
    description: "Get comprehensive guidance on personal branding, career transitions, and professional growth strategies."
  }
];

const structuredData = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "Skillset Master by Aryan Singh",
  "description": "Master trending skills with comprehensive courses in AI, Web3, Cloud Computing, and more.",
  "url": "https://skillsetmaster.com",
  "brand": {
    "@type": "Brand",
    "name": "Skillset Master"
  },
  "author": {
    "@type": "Person",
    "name": "Aryan Singh",
    "alumniOf": "Google"
  },
  "offers": {
    "@type": "Offer",
    "availability": "https://schema.org/InStock",
    "price": "39.99",
    "priceCurrency": "USD"
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.7",
    "reviewCount": "1000"
  }
};
---

<Layout
  title={seoMetadata.title}
  description={seoMetadata.description}
>
  <>
    <meta name="keywords" content={seoMetadata.keywords} />
    <meta name="author" content="Aryan Singh" />
    <meta property="og:title" content={seoMetadata.title} />
    <meta property="og:description" content={seoMetadata.description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://coderaryan.com/skillset-master" />
    <meta property="og:image" content="https://coderaryan.com/images/skillset-master-og.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content="@singh_aryan_45" />
    <meta name="twitter:title" content={seoMetadata.title} />
    <meta name="twitter:description" content={seoMetadata.description} />
    <link rel="canonical" href="https://coderaryan.com/skillset-master" />
  </>

  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-12">
    <header class="text-center mb-16">
      <h1 class="text-4xl font-bold text-gray-900 mb-4">The Story of Skillset Master</h1>
      <p class="text-xl text-gray-600 max-w-3xl mx-auto">
        Empowering professionals to master the most in-demand skills of tomorrow
      </p>
    </header>

    {/* Metrics Section */}
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6 mb-16">
      {metrics.map(metric => (
        <div class="text-center p-6 bg-white rounded-xl border border-gray-200 shadow-sm">
          <div class="text-3xl font-bold text-primary-600 mb-2">{metric.value}</div>
          <div class="text-gray-600">{metric.label}</div>
        </div>
      ))}
    </div>

    {/* Story Section */}
    <section class="prose prose-lg max-w-none mb-16">
      <h2>The Journey</h2>
      <p>
        After the success of 30 Days Coding, we recognized that modern professionals need expertise beyond 
        just technical skills. While many platforms focused on specific niches, there wasn't a comprehensive 
        platform that offered quality education across various in-demand domains. That's how Skillset Master 
        was born.
      </p>
      
      <p>
        We built Skillset Master to be an all-in-one learning destination where professionals can master 
        multiple skills - from Digital Marketing and AI to Video Editing and Study Abroad preparation. 
        Our courses combine theoretical knowledge with practical applications, taught by experts who have 
        excelled in their respective fields.
      </p>

      <h2>The Impact</h2>
      <p>
        Since our launch, Skillset Master has helped over 1,000 professionals transition into new roles 
        and advance their careers. Our students have secured positions in emerging fields like AI, 
        Blockchain, and Cloud Architecture at leading tech companies. The platform has grown to become 
        a comprehensive ecosystem for professional growth, offering:
      </p>

      <div class="grid md:grid-cols-2 gap-6 my-8">
        {features.map(feature => (
          <div class="p-6 border-2 border-blue-500 bg-gray-50 rounded-xl hover:bg-white hover:shadow-lg transition-all duration-300 group">
            <h3 class="text-xl font-semibold text-gray-900 mb-3 group-hover:text-primary-600 transition-colors">{feature.title}</h3>
            <p class="text-gray-600 leading-relaxed">{feature.description}</p>
          </div>
        ))}
      </div>

      <h2>Looking Forward</h2>
      <p>
        As technology continues to evolve at a rapid pace, Skillset Master remains committed to staying 
        ahead of the curve. We're constantly adding new courses, bringing in more industry experts, and 
        enhancing our platform to ensure our students are always learning the skills that matter most 
        in today's job market.
      </p>
    </section>

    {/* CTA Section */}
    <section class="text-center bg-primary-50 rounded-2xl p-8 mb-16">
      <h2 class="text-3xl font-bold text-gray-900 mb-4">Level Up Your Career Today</h2>
      <p class="text-xl text-gray-600 mb-8">
        Join thousands of professionals who have transformed their careers with Skillset Master
      </p>
      <a 
        href="https://skillsetmaster.com"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center px-8 py-4 bg-primary-600 text-white rounded-lg hover:bg-primary-700 transition-colors text-lg font-medium"
      >
        Explore Skills
      </a>
    </section>
  </div>
</Layout> 