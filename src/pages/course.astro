// Get course posts for the sidebar
const coursePosts = await getCollection('course');
const sortedPosts = coursePosts.sort((a, b) => {
  const dateA = a.data.pubDate instanceof Date ? a.data.pubDate : new Date(a.data.pubDate);
  const dateB = b.data.pubDate instanceof Date ? b.data.pubDate : new Date(b.data.pubDate);
  return dateA.getTime() - dateB.getTime();
});

// Group posts by category
const postsByCategory = sortedPosts.reduce((acc, post) => {
  const category = post.data.category;
  if (!acc[category]) {
    acc[category] = [];
  }
  acc[category].push(post);
  return acc;
}, {});

// Get current path for active state
const currentPath = Astro.url.pathname;

// Add state for mobile menu
const isMobileMenuOpen = false;
---

<Layout 
  title="Build SaaS with AI - Complete Course"
  description="Learn to build profitable SaaS products with AI in days, not months. Complete course by Ex-Google Engineer."
>
  <main class="w-full py-12 px-4 sm:px-6 lg:px-8">
