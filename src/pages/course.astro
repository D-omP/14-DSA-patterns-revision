        <h2 class="text-3xl font-bold text-center mb-16">Course Curriculum</h2>
        
        <div class="space-y-12">
          {courseModules.map((module) => (
            <div class="bg-white rounded-2xl shadow-sm hover:shadow-md transition-shadow p-8">
