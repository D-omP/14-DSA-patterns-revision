---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import type { GetStaticPaths } from 'astro';
import CourseTabs from '../../components/CourseTabs.astro';

export async function getStaticPaths() {
  const coursePosts = await getCollection('course');
  return coursePosts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await post.render();

// Get all posts for sidebar
const coursePosts = await getCollection('course');
const sortedPosts = coursePosts.sort((a, b) => {
  // Sort by priority
  if (a.data.priority !== b.data.priority) {
    return a.data.priority - b.data.priority;
  }
  // Then sort by date if needed
  return new Date(a.data.pubDate).getTime() - new Date(b.data.pubDate).getTime();
});

const currentPath = Astro.url.pathname;
---

<Layout title={post.data.title} description={post.data.description}>
  <div class="flex min-h-screen relative bg-gray-50">
    <!-- Left Sidebar -->
    <aside 
      id="left-sidebar"
      class="fixed left-0 top-16 w-[85vw] md:w-72 h-[calc(100vh-4rem)] overflow-y-auto border-r border-gray-200 bg-white transform -translate-x-full transition-transform duration-200 ease-in-out md:translate-x-0 z-40"
    >
      <div class="p-8">
        <!-- Header -->
        <div class="flex items-center gap-3 mb-8">
          <div class="w-10 h-10 bg-primary-100 rounded-xl flex items-center justify-center">
            <svg class="w-6 h-6 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
            </svg>
          </div>
          <h2 class="text-xl font-bold text-gray-900">DSA Patterns</h2>
        </div>

        <!-- Navigation -->
        <nav>
          <ul class="space-y-2">
            {sortedPosts.map((coursePost, index) => {
              const isActive = currentPath === `/course/${coursePost.slug}`;
              return (
                <li>
                  <a
                    href={`/course/${coursePost.slug}`}
                    class={`
                      flex items-center gap-3 px-4 py-3 rounded-xl text-sm transition-all
                      ${isActive 
                        ? 'bg-primary-50 text-primary-700 font-medium shadow-sm' 
                        : 'text-gray-600 hover:bg-gray-50 hover:text-gray-900'
                      }
                    `}
                  >
                    <span class={`
                      w-6 h-6 flex items-center justify-center rounded-lg text-sm
                      ${isActive ? 'bg-primary-100 text-primary-700' : 'bg-gray-100 text-gray-600'}
                    `}>
                      {index + 1}
                    </span>
                    <span class="truncate">{coursePost.data.title}</span>
                  </a>
                </li>
              );
            })}
          </ul>
        </nav>
      </div>
    </aside>

    <!-- Main Content -->
    <main class="w-full md:ml-72 lg:mr-64 flex-1 min-w-0">
      <div class="max-w-3xl mx-auto px-6 py-12">
        <CourseTabs slug={post.slug}>
          <Content />
        </CourseTabs>
      </div>
    </main>

    <!-- Right Sidebar - TOC -->
    <aside 
      id="right-sidebar"
      class="fixed right-0 top-16 w-[85vw] md:w-64 h-[calc(100vh-4rem)] overflow-y-auto border-l border-gray-200 bg-white transform translate-x-full transition-transform duration-200 ease-in-out lg:translate-x-0 z-40"
    >
      <div class="p-8">
        <div class="flex items-center gap-3 mb-6">
          <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7" />
          </svg>
          <h2 class="text-sm font-bold text-gray-900 uppercase tracking-wide">
            Table of Contents
          </h2>
        </div>
        <nav class="space-y-2">
          {headings.map((heading) => (
            <a
              href={`#${heading.slug}`}
              class={`
                block py-2 pl-${(heading.depth - 1) * 4} text-sm transition-colors
                ${heading.depth === 1 ? 'font-medium text-gray-900' : 'text-gray-600'}
                hover:text-primary-600 hover:bg-gray-50 rounded-lg
              `}
            >
              {heading.text}
            </a>
          ))}
        </nav>
      </div>
    </aside>
  </div>
</Layout>

<style>
  /* Hide scrollbar for Chrome, Safari and Opera */
  aside::-webkit-scrollbar {
    display: none;
  }

  /* Hide scrollbar for IE, Edge and Firefox */
  aside {
    -ms-overflow-style: none;  /* IE and Edge */
    scrollbar-width: none;  /* Firefox */
  }

  /* Add smooth scrolling to the whole page */
  html {
    scroll-behavior: smooth;
  }

  @media (max-width: 768px) {
    .prose {
      font-size: 1rem;
      line-height: 1.6;
    }
    
    main {
      margin-left: 0;
      margin-right: 0;
      padding-bottom: 6rem; /* Space for FAB */
    }

    /* Improve mobile typography */
    .prose h1 {
      font-size: 2rem;
      line-height: 1.2;
    }

    .prose h2 {
      font-size: 1.5rem;
      margin-top: 2rem;
    }

    .prose p {
      margin-bottom: 1.25rem;
    }
  }

  /* Add new styles */
  .prose {
    max-width: 65ch;
    margin: 0 auto;
  }

  .prose h1 {
    margin-top: 0;
    margin-bottom: 2rem;
  }

  .prose h2 {
    margin-top: 2.5rem;
    margin-bottom: 1.5rem;
  }

  .prose h3 {
    margin-top: 2rem;
    margin-bottom: 1rem;
  }

  .prose p {
    margin-bottom: 1.5rem;
    line-height: 1.75;
  }

  .prose ul {
    margin-top: 1rem;
    margin-bottom: 1rem;
  }

  .prose li {
    margin-top: 0.5rem;
    margin-bottom: 0.5rem;
  }
</style>

<script>
  const navButton = document.getElementById('nav-button');
  const progressButton = document.getElementById('progress-button');
  const leftSidebar = document.getElementById('left-sidebar');
  const overlay = document.getElementById('sidebar-overlay');
  const menuIcon = document.getElementById('menu-icon');
  const closeIcon = document.getElementById('close-icon');

  let isMenuOpen = false;

  function toggleMenu() {
    isMenuOpen = !isMenuOpen;
    leftSidebar?.classList.toggle('translate-x-0');
    overlay?.classList.toggle('hidden');
    menuIcon?.classList.toggle('hidden');
    closeIcon?.classList.toggle('hidden');
  }

  // Navigation menu button
  navButton?.addEventListener('click', toggleMenu);

  // Progress button (for future implementation)
  progressButton?.addEventListener('click', () => {
    // TODO: Implement progress tracking functionality
    console.log('Progress tracking to be implemented');
  });

  // Close menu when overlay is clicked
  overlay?.addEventListener('click', toggleMenu);

  // Close menu when escape key is pressed
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isMenuOpen) {
      toggleMenu();
    }
  });

  // Close menu when window is resized to desktop size
  window.addEventListener('resize', () => {
    if (window.innerWidth >= 768 && isMenuOpen) {
      toggleMenu();
    }
  });

  // Add intersection observer for TOC highlighting
  const observerOptions = {
    rootMargin: '0px 0px -66%',
    threshold: 1.0
  };

  const observer = new IntersectionObserver(entries => {
    entries.forEach(entry => {
      const id = entry.target.getAttribute('id');
      if (entry.isIntersecting) {
        document.querySelector(`nav a[href="#${id}"]`)
          ?.classList.add('text-primary-600', 'font-medium');
      } else {
        document.querySelector(`nav a[href="#${id}"]`)
          ?.classList.remove('text-primary-600', 'font-medium');
      }
    });
  }, observerOptions);

  // Track all sections that have an `id` applied
  document.querySelectorAll('h1[id], h2[id], h3[id], h4[id], h5[id], h6[id]')
    .forEach((section) => {
      observer.observe(section);
    });
</script> 