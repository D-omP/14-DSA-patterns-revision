---
import { getCollection } from 'astro:content';
import CourseLayout from '../../layouts/CourseLayout.astro';
import CourseTabs from '../../components/CourseTabs.astro';
import { courseContent } from '../../data/course-content';

export async function getStaticPaths() {
  const courseEntries = await getCollection('course');
  return courseEntries.map(entry => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();

// Get practice problems and resources for this pattern
const patternData = courseContent[entry.slug] || {
  practice: { problems: [] },
  resources: { videos: [], articles: [], visualizations: [] }
};
---

<CourseLayout frontmatter={entry.data}>
  <div class="prose max-w-none">
    <h1>{entry.data.title}</h1>
    <p class="text-gray-600">{entry.data.description}</p>
  </div>

  <CourseTabs slug={entry.slug}>
    <Content />
  </CourseTabs>
</CourseLayout>

<style>
  /* Hide scrollbar for Chrome, Safari and Opera */
  aside::-webkit-scrollbar {
    display: none;
  }

  /* Hide scrollbar for IE, Edge and Firefox */
  aside {
    -ms-overflow-style: none;  /* IE and Edge */
    scrollbar-width: none;  /* Firefox */
  }

  /* Add smooth scrolling to the whole page */
  html {
    scroll-behavior: smooth;
  }

  @media (max-width: 768px) {
    .prose {
      font-size: 1rem;
      line-height: 1.6;
    }
    
    main {
      margin-left: 0;
      margin-right: 0;
      padding-bottom: 6rem; /* Space for FAB */
    }

    /* Improve mobile typography */
    .prose h1 {
      font-size: 2rem;
      line-height: 1.2;
    }

    .prose h2 {
      font-size: 1.5rem;
      margin-top: 2rem;
    }

    .prose p {
      margin-bottom: 1.25rem;
    }
  }

  /* Add new styles */
  .prose {
    max-width: none;
  }

  .prose h1 {
    margin-bottom: 0.5rem;
  }

  .prose h2 {
    margin-top: 2.5rem;
    margin-bottom: 1.5rem;
  }

  .prose h3 {
    margin-top: 2rem;
    margin-bottom: 1rem;
  }

  .prose p {
    margin-bottom: 1.5rem;
    line-height: 1.75;
  }

  .prose ul {
    margin-top: 1rem;
    margin-bottom: 1rem;
  }

  .prose li {
    margin-top: 0.5rem;
    margin-bottom: 0.5rem;
  }
</style>

<script>
  const navButton = document.getElementById('nav-button');
  const progressButton = document.getElementById('progress-button');
  const leftSidebar = document.getElementById('left-sidebar');
  const overlay = document.getElementById('sidebar-overlay');
  const menuIcon = document.getElementById('menu-icon');
  const closeIcon = document.getElementById('close-icon');

  let isMenuOpen = false;

  function toggleMenu() {
    isMenuOpen = !isMenuOpen;
    leftSidebar?.classList.toggle('translate-x-0');
    overlay?.classList.toggle('hidden');
    menuIcon?.classList.toggle('hidden');
    closeIcon?.classList.toggle('hidden');
  }

  // Navigation menu button
  navButton?.addEventListener('click', toggleMenu);

  // Progress button (for future implementation)
  progressButton?.addEventListener('click', () => {
    // TODO: Implement progress tracking functionality
    console.log('Progress tracking to be implemented');
  });

  // Close menu when overlay is clicked
  overlay?.addEventListener('click', toggleMenu);

  // Close menu when escape key is pressed
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isMenuOpen) {
      toggleMenu();
    }
  });

  // Close menu when window is resized to desktop size
  window.addEventListener('resize', () => {
    if (window.innerWidth >= 768 && isMenuOpen) {
      toggleMenu();
    }
  });

  // Add intersection observer for TOC highlighting
  const observerOptions = {
    rootMargin: '0px 0px -66%',
    threshold: 1.0
  };

  const observer = new IntersectionObserver(entries => {
    entries.forEach(entry => {
      const id = entry.target.getAttribute('id');
      if (entry.isIntersecting) {
        document.querySelector(`nav a[href="#${id}"]`)
          ?.classList.add('text-primary-600', 'font-medium');
      } else {
        document.querySelector(`nav a[href="#${id}"]`)
          ?.classList.remove('text-primary-600', 'font-medium');
      }
    });
  }, observerOptions);

  // Track all sections that have an `id` applied
  document.querySelectorAll('h1[id], h2[id], h3[id], h4[id], h5[id], h6[id]')
    .forEach((section) => {
      observer.observe(section);
    });
</script> 