---
import { getCollection } from 'astro:content';
import CourseLayout from '../../layouts/CourseLayout.astro';
import CourseTabs from '../../components/CourseTabs.astro';
import { courseContent } from '../../data/course-content';

export async function getStaticPaths() {
  const courseEntries = await getCollection('course');
  return courseEntries.map(entry => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();

// Get all course content and sort by priority
const allCourseContent = await getCollection('course');
const sortedPatterns = allCourseContent.sort((a, b) => a.data.priority - b.data.priority);

// Get practice problems and resources for this pattern
const patternData = courseContent[entry.slug] || {
  practice: { problems: [] },
  resources: { videos: [], articles: [], visualizations: [] }
};
---

<CourseLayout frontmatter={entry.data}>
  <div class="flex relative">
    <!-- Sidebar -->
    <div class="hidden md:block w-64 h-[calc(100vh-4rem)] overflow-y-auto fixed left-0 top-16 p-4 bg-white border-r">
      <h3 class="text-lg font-semibold text-gray-900 mb-4">DSA Patterns</h3>
      <ul class="space-y-2">
        {sortedPatterns.map((pattern) => (
          <li>
            <a
              href={`/course/${pattern.slug}`}
              class={`block px-4 py-2 rounded-lg text-sm ${
                Astro.url.pathname === `/course/${pattern.slug}`
                  ? 'bg-primary-50 text-primary-700 font-medium'
                  : 'text-gray-600 hover:bg-gray-50'
              }`}
            >
              {pattern.data.title}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <!-- Main Content -->
    <div class="w-full">
      <main class="max-w-3xl mx-auto px-4 sm:px-6 py-8">
        <div class="prose prose-sm sm:prose max-w-none">
          <h1 class="text-2xl sm:text-4xl font-bold">{entry.data.title}</h1>
          <p class="text-gray-600 text-sm sm:text-base">{entry.data.description}</p>
        </div>

        <CourseTabs slug={entry.slug}>
          <Content />
        </CourseTabs>
      </main>
    </div>
  </div>
</CourseLayout>

<style>
  /* Ensure proper content width on mobile */
  :global(.prose) {
    max-width: 100%;
  }
  
  /* Adjust font sizes for mobile */
  :global(.prose p) {
    font-size: 16px;
    line-height: 1.6;
  }
  
  :global(.prose pre) {
    font-size: 14px;
    border-radius: 0.5rem;
  }
  
  /* Better spacing on mobile */
  :global(.prose > * + *) {
    margin-top: 1em;
  }
</style>

<script>
  const navButton = document.getElementById('nav-button');
  const progressButton = document.getElementById('progress-button');
  const leftSidebar = document.getElementById('left-sidebar');
  const overlay = document.getElementById('sidebar-overlay');
  const menuIcon = document.getElementById('menu-icon');
  const closeIcon = document.getElementById('close-icon');

  let isMenuOpen = false;

  function toggleMenu() {
    isMenuOpen = !isMenuOpen;
    leftSidebar?.classList.toggle('translate-x-0');
    overlay?.classList.toggle('hidden');
    menuIcon?.classList.toggle('hidden');
    closeIcon?.classList.toggle('hidden');
  }

  // Navigation menu button
  navButton?.addEventListener('click', toggleMenu);

  // Progress button (for future implementation)
  progressButton?.addEventListener('click', () => {
    // TODO: Implement progress tracking functionality
    console.log('Progress tracking to be implemented');
  });

  // Close menu when overlay is clicked
  overlay?.addEventListener('click', toggleMenu);

  // Close menu when escape key is pressed
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isMenuOpen) {
      toggleMenu();
    }
  });

  // Close menu when window is resized to desktop size
  window.addEventListener('resize', () => {
    if (window.innerWidth >= 768 && isMenuOpen) {
      toggleMenu();
    }
  });

  // Add intersection observer for TOC highlighting
  const observerOptions = {
    rootMargin: '0px 0px -66%',
    threshold: 1.0
  };

  const observer = new IntersectionObserver(entries => {
    entries.forEach(entry => {
      const id = entry.target.getAttribute('id');
      if (entry.isIntersecting) {
        document.querySelector(`nav a[href="#${id}"]`)
          ?.classList.add('text-primary-600', 'font-medium');
      } else {
        document.querySelector(`nav a[href="#${id}"]`)
          ?.classList.remove('text-primary-600', 'font-medium');
      }
    });
  }, observerOptions);

  // Track all sections that have an `id` applied
  document.querySelectorAll('h1[id], h2[id], h3[id], h4[id], h5[id], h6[id]')
    .forEach((section) => {
      observer.observe(section);
    });
</script> 