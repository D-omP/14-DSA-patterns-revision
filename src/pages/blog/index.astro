---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import SearchBar from '../../components/SearchBar.astro';

// Get all blog posts
const posts = await getCollection('blog');
const sortedPosts = posts.sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());

// Group posts by category
const groupedPosts = sortedPosts.reduce((acc, post) => {
  const category = post.data.category;
  if (!acc[category]) acc[category] = [];
  acc[category].push(post);
  return acc;
}, {});

// SEO metadata
const seoMetadata = {
  title: "BabySaaS Blog - AI & SaaS Development Guides",
  description: "Learn how to build and launch successful AI-powered SaaS products. Practical guides, tutorials, and insights from experienced founders.",
  keywords: [
    "saas development",
    "ai saas tutorials",
    "build saas product",
    "saas founder guides",
    "ai integration guide",
    "saas development blog",
    "startup tutorials",
    "nextjs saas guide",
    "ai development",
    "saas best practices",
    "launch saas product",
    "saas architecture",
    "ai tools guide",
    "saas monetization",
    "tech startup blog"
  ].join(", "),
  ogImage: "https://babysaas.com/blog-og-image.png",
  twitterHandle: "@babysaas",
  siteUrl: "https://babysaas.com/blog",
  type: "blog",
  author: {
    "@type": "Person",
    name: "BabySaaS Team",
    url: "https://babysaas.com",
    sameAs: [
      "https://twitter.com/babysaas",
      "https://github.com/babysaas",
      "https://discord.gg/babysaas"
    ]
  },
  publisher: {
    "@type": "Organization",
    name: "BabySaaS",
    logo: {
      "@type": "ImageObject",
      url: "https://babysaas.com/logo.png"
    }
  }
};

// Generate structured data
const structuredData = {
  "@context": "https://schema.org",
  "@type": "Blog",
  "name": "BabySaaS Blog",
  "description": seoMetadata.description,
  "url": seoMetadata.siteUrl,
  "author": seoMetadata.author,
  "publisher": seoMetadata.publisher,
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": seoMetadata.siteUrl
  }
};
---

<Layout 
  title={seoMetadata.title}
  description={seoMetadata.description}
  ogImage={seoMetadata.ogImage}
  twitterHandle={seoMetadata.twitterHandle}
  structuredData={structuredData}
>
  <main class="bg-gray-50">
    <!-- Hero Section -->
    <div class="max-w-7xl mx-auto py-16 px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <h1 class="text-4xl font-bold text-gray-900 sm:text-5xl font-display">
          Build Better 
          <span class="relative inline-block">
            SaaS Products
            <div class="absolute inset-x-0 bottom-0 h-3 bg-primary-100 -z-10 transform -rotate-1"></div>
          </span>
        </h1>
        <p class="mt-4 text-xl text-gray-600 max-w-2xl mx-auto">
          Practical guides and insights to help you build and launch successful AI-powered SaaS products
        </p>
      </div>

      <!-- Featured Posts Grid -->
      <div class="mt-16 grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        {sortedPosts.map(post => (
          <article class="bg-white rounded-2xl shadow-md hover:shadow-xl transition-shadow overflow-hidden">
            <a href={`/blog/${post.slug}`}>
              <img 
                src={post.data.image || "https://images.unsplash.com/photo-1516321318423-f06f85e504b3?auto=format&fit=crop&q=80&w=800"} 
                alt={post.data.title}
                class="w-full h-48 object-cover"
                loading="lazy"
              />
              <div class="p-6">
                <div class="flex items-center gap-4 mb-4">
                  <span class="px-3 py-1 text-sm font-medium text-primary-700 bg-primary-50 rounded-full">
                    {post.data.category}
                  </span>
                  <time class="text-sm text-gray-500" datetime={post.data.pubDate}>
                    {new Date(post.data.pubDate).toLocaleDateString('en-US', {
                      month: 'long',
                      day: 'numeric',
                      year: 'numeric'
                    })}
                  </time>
                </div>
                <h2 class="text-xl font-bold text-gray-900 mb-2">
                  {post.data.title}
                </h2>
                <p class="text-gray-600 mb-4">
                  {post.data.description}
                </p>
                <div class="flex items-center gap-2">
                  <img 
                    src={post.data.authorImage || "https://babysaas.com/team/default-avatar.png"}
                    alt={post.data.author}
                    class="w-8 h-8 rounded-full"
                  />
                  <span class="text-sm text-gray-600">{post.data.author}</span>
                </div>
              </div>
            </a>
          </article>
        ))}
      </div>
    </div>
  </main>
</Layout> 