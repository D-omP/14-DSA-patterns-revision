---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import SearchBar from '../../components/SearchBar.astro';

const posts = await getCollection('blog');
const sortedPosts = posts.sort((a, b) => 
  b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// Group posts by category
const groupedPosts = sortedPosts.reduce((acc, post) => {
  const category = post.data.category;
  if (!acc[category]) acc[category] = [];
  acc[category].push(post);
  return acc;
}, {});

// Generate metadata description
const latestCategories = [...new Set(sortedPosts.slice(0, 5).map(post => post.data.category))];
const categoryString = latestCategories.map(cat => cat.replace('-', ' ')).join(', ');

const description = `Explore expert insights on ${categoryString}. Written by Aryan Singh, ex-Google engineer sharing insights on technology, AI, startups, social media, and more. Updated ${new Date().toLocaleDateString()}.`;

// Generate structured data
const structuredData = {
  "@context": "https://schema.org",
  "@type": "Blog",
  "name": "Aryan Singh's Blog",
  "description": description,
  "url": new URL(Astro.url.pathname, Astro.site).toString(),
  "author": {
    "@type": "Person",
    "name": "Aryan Singh",
    "jobTitle": "Software Engineer",
    "alumniOf": "Google",
    "url": "https://coderaryan.com",
    "sameAs": [
      "https://twitter.com/singh1aryan",
      "https://linkedin.com/in/singh1aryan",
      "https://github.com/singh1aryan"
    ]
  },
  "publisher": {
    "@type": "Organization",
    "name": "Aryan Singh",
    "logo": {
      "@type": "ImageObject",
      "url": "https://coderaryan.com/logo.png"
    }
  },
  "blogPost": sortedPosts.map(post => ({
    "@type": "BlogPosting",
    "headline": post.data.title,
    "description": post.data.description,
    "datePublished": post.data.pubDate.toISOString(),
    "dateModified": post.data.modifiedDate?.toISOString() || post.data.pubDate.toISOString(),
    "author": {
      "@type": "Person",
      "name": post.data.author || "Aryan Singh"
    },
    "keywords": post.data.tags?.join(", ")
  }))
};
---

<Layout 
  title="Aryan Singh's Blog"
  description={description}
  image="/images/blog-og.png"
  article={false}
  publishDate={new Date()}
  author="Aryan Singh"
>
  <!-- Add structured data -->
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <!-- Add additional meta tags -->
  <Fragment slot="head">
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).toString()} />
    <meta name="robots" content="index, follow" />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="author" content="Aryan Singh" />
    <meta name="keywords" content={`software engineering, ${categoryString}, tech career, programming tutorials, coding tips`} />
    
    <!-- RSS Feed -->
    <link 
      rel="alternate" 
      type="application/rss+xml" 
      title="Aryan Singh's Blog RSS Feed" 
      href="/rss.xml"
    />
  </Fragment>

  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-12">
    <div class="mb-12">
      <h1 class="text-4xl font-bold text-gray-900 mb-4">Detailed Blog Posts</h1>
      <p class="text-xl text-gray-600 mb-8">
        Insights on building products, indie hacking, and technology. From an engineer and creator sharing real-world experiences in building and scaling projects.
      </p>
      <div class="relative">
        <input 
          type="text" 
          id="searchInput"
          placeholder="Search posts..."
          class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500"
        />
      </div>
    </div>

    <div id="blogPosts">
      {Object.entries(groupedPosts).map(([category, posts]) => (
        <div class="mb-12 category-section">
          <h2 class="text-2xl font-bold text-gray-900 mb-6 border-b border-gray-200 pb-2">
            {category.split('-').map(word => word.charAt(0).toUpperCase() + word.slice(1)).join(' ')}
          </h2>
          <ul class="space-y-4">
            {posts.map(post => (
              <li class="post-item" data-title={post.data.title.toLowerCase()} data-tags={post.data.tags?.join(' ').toLowerCase()}>
                <a href={`/blog/${post.slug}`} class="group flex justify-between items-center hover:bg-gray-50 p-3 rounded-lg transition-colors">
                  <div>
                    <h3 class="text-lg font-medium text-gray-900 group-hover:text-primary-600">
                      {post.data.title}
                    </h3>
                    <p class="text-sm text-gray-500">
                      {new Date(post.data.pubDate).toLocaleDateString('en-US', {
                        year: 'numeric',
                        month: 'long',
                        day: 'numeric'
                      })}
                    </p>
                  </div>
                  <svg class="w-5 h-5 text-gray-400 group-hover:text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>

  <script>
    // Search functionality
    const searchInput = document.getElementById('searchInput');
    const postItems = document.querySelectorAll('.post-item');
    const categorySections = document.querySelectorAll('.category-section');

    searchInput?.addEventListener('input', (e) => {
      const target = e.target as HTMLInputElement;
      const searchTerm = target.value.toLowerCase().trim();
      
      // Track if each category has visible posts
      const categoryVisibility = new Map();

      postItems.forEach(item => {
        const title = (item.getAttribute('data-title') || '').toLowerCase();
        const tags = (item.getAttribute('data-tags') || '').toLowerCase();
        const description = item.querySelector('h3')?.textContent?.toLowerCase() || '';
        
        const isMatch = !searchTerm || 
          title.includes(searchTerm) || 
          tags.includes(searchTerm) || 
          description.includes(searchTerm);

        // Use classList instead of style.display
        item.classList.toggle('hidden', !isMatch);
        
        // Track category visibility
        const categorySection = item.closest('.category-section');
        if (categorySection) {
          const hasVisiblePost = categoryVisibility.get(categorySection) || isMatch;
          categoryVisibility.set(categorySection, hasVisiblePost);
        }
      });

      // Update category visibility
      categorySections.forEach(section => {
        const hasVisiblePosts = categoryVisibility.get(section) || false;
        section.classList.toggle('hidden', !hasVisiblePosts);
      });
    });
  </script>

  <style>
    .hidden {
      display: none;
    }
  </style>
</Layout> 