---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const posts = await getCollection('blog');
const sortedPosts = posts.sort((a, b) => {
  return new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime();
});

// Group posts by year and month
const postsByDate = sortedPosts.reduce((acc, post) => {
  const date = new Date(post.data.pubDate);
  const year = date.getFullYear();
  const month = date.toLocaleString('default', { month: 'long' });
  
  if (!acc[year]) {
    acc[year] = {};
  }
  if (!acc[year][month]) {
    acc[year][month] = [];
  }
  
  acc[year][month].push(post);
  return acc;
}, {} as Record<number, Record<string, typeof posts>>);

// SEO metadata
const seoMetadata = {
  title: "14DSA Blog - Data Structures and Algorithms",
  description: "Learn data structures and algorithms through our comprehensive patterns-based approach. Master coding interviews with practical examples.",
  keywords: [
    "data structures",
    "algorithms",
    "coding patterns",
    "interview preparation",
    "leetcode solutions",
    "dsa patterns",
    "algorithm tutorials",
    "coding interview",
    "programming patterns",
    "problem solving"
  ].join(", "),
  ogImage: "https://14dsa.com/blog-og-image.png",
  twitterHandle: "@14dsa",
  siteUrl: "https://14dsa.com/blog",
  type: "blog",
  author: {
    "@type": "Person",
    name: "14DSA Team",
    url: "https://14dsa.com",
    sameAs: [
      "https://twitter.com/14dsa",
      "https://github.com/14dsa",
      "https://discord.gg/14dsa"
    ]
  },
  publisher: {
    "@type": "Organization",
    name: "14DSA",
    logo: {
      "@type": "ImageObject",
      url: "https://14dsa.com/logo.png"
    }
  }
};

// Generate structured data
const structuredData = {
  "@context": "https://schema.org",
  "@type": "Blog",
  "name": "14DSA Blog",
  "description": seoMetadata.description,
  "url": seoMetadata.siteUrl,
  "author": seoMetadata.author,
  "publisher": seoMetadata.publisher,
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": seoMetadata.siteUrl
  }
};
---

<Layout 
  title={seoMetadata.title}
  description={seoMetadata.description}
  ogImage={seoMetadata.ogImage}
  twitterHandle={seoMetadata.twitterHandle}
  structuredData={structuredData}
>
  <main class="max-w-4xl mx-auto px-4 py-12">
    <div class="mb-12">
      <h1 class="text-4xl font-bold text-gray-900 mb-4">Blog</h1>
      <p class="text-lg text-gray-600">
        Insights and tutorials about Data Structures, Algorithms, and Software Engineering
      </p>
    </div>

    <div class="space-y-16">
      {Object.entries(postsByDate).map(([year, months]) => (
        <div>
          <h2 class="text-2xl font-bold text-gray-900 mb-8">{year}</h2>
          <div class="space-y-12">
            {Object.entries(months).map(([month, monthPosts]) => (
              <div>
                <h3 class="text-xl font-semibold text-gray-700 mb-6">{month}</h3>
                <ul class="space-y-6">
                  {monthPosts.map((post) => (
                    <li>
                      <a 
                        href={`/blog/${post.slug}`}
                        class="group block"
                      >
                        <article class="flex items-start justify-between">
                          <div>
                            <h4 class="text-lg font-medium text-gray-900 group-hover:text-primary-600 mb-2">
                              {post.data.title}
                            </h4>
                            <p class="text-gray-600 line-clamp-2 mb-3">
                              {post.data.description}
                            </p>
                            <div class="flex items-center gap-4">
                              <time 
                                datetime={post.data.pubDate}
                                class="text-sm text-gray-500"
                              >
                                {new Date(post.data.pubDate).toLocaleDateString('en-US', {
                                  day: 'numeric',
                                  month: 'long',
                                  year: 'numeric'
                                })}
                              </time>
                              <div class="flex gap-2">
                                {post.data.tags.map((tag) => (
                                  <span class="text-xs px-2 py-1 bg-gray-100 text-gray-600 rounded-full">
                                    {tag}
                                  </span>
                                ))}
                              </div>
                            </div>
                          </div>
                          <div class="ml-4">
                            <svg 
                              class="w-5 h-5 text-gray-400 group-hover:text-primary-600"
                              fill="none" 
                              stroke="currentColor" 
                              viewBox="0 0 24 24"
                            >
                              <path 
                                stroke-linecap="round" 
                                stroke-linejoin="round" 
                                stroke-width="2" 
                                d="M9 5l7 7-7 7"
                              />
                            </svg>
                          </div>
                        </article>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </main>
</Layout> 