---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import SearchBar from '../../components/SearchBar.astro';

const posts = await getCollection('blog');
const sortedPosts = posts.sort((a, b) => 
  b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// Generate metadata description
const latestCategories = [...new Set(sortedPosts.slice(0, 5).map(post => post.data.category))];
const categoryString = latestCategories
  .map(cat => cat.replace('-', ' '))
  .join(', ');

const description = `Explore expert insights on ${categoryString}. Written by Aryan Singh, ex-Google engineer sharing insights on technology, AI, startups, social media, and more. Updated ${new Date().toLocaleDateString()}.`;

// Generate structured data
const structuredData = {
  "@context": "https://schema.org",
  "@type": "Blog",
  "name": "Aryan Singh's Blog",
  "description": description,
  "url": new URL(Astro.url.pathname, Astro.site).toString(),
  "author": {
    "@type": "Person",
    "name": "Aryan Singh",
    "jobTitle": "Software Engineer",
    "alumniOf": "Google",
    "url": "https://coderaryan.com",
    "sameAs": [
      "https://twitter.com/singh1aryan",
      "https://linkedin.com/in/singh1aryan",
      "https://github.com/singh1aryan"
    ]
  },
  "publisher": {
    "@type": "Organization",
    "name": "Aryan Singh",
    "logo": {
      "@type": "ImageObject",
      "url": "https://coderaryan.com/logo.png"
    }
  },
  "blogPost": sortedPosts.map(post => ({
    "@type": "BlogPosting",
    "headline": post.data.title,
    "description": post.data.description,
    "datePublished": post.data.pubDate.toISOString(),
    "dateModified": post.data.modifiedDate?.toISOString() || post.data.pubDate.toISOString(),
    "author": {
      "@type": "Person",
      "name": post.data.author || "Aryan Singh"
    },
    "keywords": post.data.tags?.join(", ")
  }))
};
---

<Layout 
  title="Aryan Singh's Blog | Technology, AI, Startups & More"
  description={description}
  image="/images/blog-og.png"
  article={false}
  publishDate={new Date()}
  author="Aryan Singh"
>
  <!-- Add structured data -->
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <!-- Add additional meta tags -->
  <Fragment slot="head">
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).toString()} />
    <meta name="robots" content="index, follow" />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="author" content="Aryan Singh" />
    <meta name="keywords" content={`software engineering, ${categoryString}, tech career, programming tutorials, coding tips`} />
    
    <!-- RSS Feed -->
    <link 
      rel="alternate" 
      type="application/rss+xml" 
      title="Aryan Singh's Blog RSS Feed" 
      href="/rss.xml"
    />
  </Fragment>

  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-12">
    <div class="mb-12">
      <h1 class="text-4xl font-bold text-gray-900 mb-4">Aryan Singh's Blog</h1>
      <p class="text-xl text-gray-600 mb-8">
        Insights on building products, indie hacking, and technology. From an engineer and creator sharing real-world experiences in building and scaling projects.
      </p>
      <SearchBar client:load />
    </div>

    <div class="space-y-8" id="posts-container">
      {sortedPosts.map(post => (
        <article class="group">
          <a href={`/blog/${post.slug}`} class="block">
            <div class="flex items-center gap-2 mb-2 text-sm">
              <span class="text-primary-600 font-medium">
                {new Date(post.data.pubDate).toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric'
                })}
              </span>
              <span class="text-gray-400">•</span>
              <span class="px-2 py-1 bg-primary-50 text-primary-700 rounded-full text-xs font-medium">
                {post.data.category.replace('-', ' ').toUpperCase()}
              </span>
            </div>
            <h2 class="text-2xl font-bold text-gray-900 group-hover:text-primary-600 transition-colors mb-3">
              {post.data.title}
            </h2>
            <p class="text-gray-600 line-clamp-2">
              {post.data.description}
            </p>
          </a>
          <div class="mt-4 border-b border-gray-100 pb-8"></div>
        </article>
      ))}
    </div>
  </div>
</Layout>

<script>
  interface ActiveFilters {
    search: string;
  }

  let activeFilters: ActiveFilters = {
    search: ''
  };

  function filterPosts() {
    const posts = document.querySelectorAll<HTMLElement>('#posts-container article');
    
    posts.forEach(post => {
      const title = post.querySelector('h2')?.textContent?.toLowerCase() || '';
      const description = post.querySelector('p')?.textContent?.toLowerCase() || '';
      const category = post.querySelector('.rounded-full')?.textContent?.toLowerCase() || '';

      const matchesSearch = !activeFilters.search || 
        title.includes(activeFilters.search.toLowerCase()) ||
        description.includes(activeFilters.search.toLowerCase()) ||
        category.includes(activeFilters.search.toLowerCase());

      post.style.display = matchesSearch ? 'block' : 'none';
    });
  }

  const searchInput = document.querySelector<HTMLInputElement>('#search-input');
  if (searchInput) {
    searchInput.addEventListener('input', (e) => {
      const target = e.target as HTMLInputElement;
      activeFilters.search = target.value;
      filterPosts();
    });
  }
</script> 