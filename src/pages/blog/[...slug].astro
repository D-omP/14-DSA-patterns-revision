---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const sortedPosts = posts.sort((a, b) => 
    b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
  );

  return sortedPosts.map((post, index) => ({
    params: { slug: post.slug },
    props: { 
      post,
      prevPost: sortedPosts[index + 1] || null,
      nextPost: sortedPosts[index - 1] || null
    },
  }));
}

const { post, prevPost, nextPost } = Astro.props;
const { Content } = await post.render();

// Generate structured data for the article
const structuredData = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": post.data.title,
  "description": post.data.description,
  "author": {
    "@type": "Person",
    "name": post.data.author,
    "url": "https://aryansingh.com/about"
  },
  "datePublished": post.data.pubDate.toISOString(),
  "dateModified": post.data.modifiedDate?.toISOString() || post.data.pubDate.toISOString(),
  "image": post.data.image || "/images/default-og.png",
  "keywords": post.data.tags.join(", "),
  "publisher": {
    "@type": "Organization",
    "name": "Aryan Singh",
    "logo": {
      "@type": "ImageObject",
      "url": "https://aryansingh.com/logo.png"
    }
  }
};
---

<Layout 
  title={post.data.title}
  description={post.data.description}
  image={post.data.image}
  article={true}
  publishDate={post.data.pubDate}
  modifiedDate={post.data.modifiedDate}
  author={post.data.author}
  tags={post.data.tags}
>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  <article class="max-w-4xl mx-auto prose prose-lg">
    <header class="mb-8">
      <h1 class="mb-2">{post.data.title}</h1>
      <div class="flex items-center text-gray-600 text-sm">
        <span>{post.data.pubDate.toLocaleDateString()}</span>
        <span class="mx-2">•</span>
        <span>{post.data.category.replace('-', ' ').toUpperCase()}</span>
      </div>
    </header>


    <!-- Post Navigation -->
    <nav class="mt-12 mb-8 border-t border-gray-200 pt-8">
      <div class="flex justify-between items-stretch flex-col sm:flex-row gap-6">
        {prevPost && (
          <a 
            href={`/blog/${prevPost.slug}`}
            class="group flex items-center text-gray-600 hover:text-primary-600 transition-colors w-full sm:w-auto"
          >
            <svg 
              class="h-5 w-5 mr-2 group-hover:-translate-x-1 transition-transform flex-shrink-0" 
              fill="none" 
              stroke="currentColor" 
              viewBox="0 0 24 24"
            >
              <path 
                stroke-linecap="round" 
                stroke-linejoin="round" 
                stroke-width="2" 
                d="M15 19l-7-7 7-7"
              />
            </svg>
            <div class="min-w-0">
              <div class="text-sm text-gray-500">Previous</div>
              <div class="font-medium truncate">{prevPost.data.title}</div>
            </div>
          </a>
        )}

        {nextPost && (
          <a 
            href={`/blog/${nextPost.slug}`}
            class="group flex items-center text-gray-600 hover:text-primary-600 transition-colors w-full sm:w-auto sm:ml-auto sm:text-right justify-end"
          >
            <div class="min-w-0">
              <div class="text-sm text-gray-500">Next</div>
              <div class="font-medium truncate">{nextPost.data.title}</div>
            </div>
            <svg 
              class="h-5 w-5 ml-2 group-hover:translate-x-1 transition-transform flex-shrink-0" 
              fill="none" 
              stroke="currentColor" 
              viewBox="0 0 24 24"
            >
              <path 
                stroke-linecap="round" 
                stroke-linejoin="round" 
                stroke-width="2" 
                d="M9 5l7 7-7 7"
              />
            </svg>
          </a>
        )}
      </div>
    </nav>

    <div class="prose prose-lg prose-primary">
      <Content />
    </div>


    <footer class="mt-12 pt-8 border-t border-gray-200">
      <div class="flex items-center justify-between">
        <div class="flex items-center space-x-4">
          <span class="text-gray-600">Share this post:</span>
          <a href="#" class="text-gray-600 hover:text-primary-600">
            <span class="sr-only">Twitter</span>
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M8.29 20.251c7.547 0 11.675-6.253 11.675-11.675 0-.178 0-.355-.012-.53A8.348 8.348 0 0022 5.92a8.19 8.19 0 01-2.357.646 4.118 4.118 0 001.804-2.27 8.224 8.224 0 01-2.605.996 4.107 4.107 0 00-6.993 3.743 11.65 11.65 0 01-8.457-4.287 4.106 4.106 0 001.27 5.477A4.072 4.072 0 012.8 9.713v.052a4.105 4.105 0 003.292 4.022 4.095 4.095 0 01-1.853.07 4.108 4.108 0 003.834 2.85A8.233 8.233 0 012 18.407a11.616 11.616 0 006.29 1.84"></path>
            </svg>
          </a>
          <a href="#" class="text-gray-600 hover:text-primary-600">
            <span class="sr-only">LinkedIn</span>
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
            </svg>
          </a>
        </div>
        <div class="flex items-center space-x-2">
          {post.data.tags.map(tag => (
            <span class="inline-block bg-gray-100 px-3 py-1 rounded-full text-sm text-gray-700">
              #{tag}
            </span>
          ))}
        </div>
      </div>
    </footer>
  </article>
</Layout>