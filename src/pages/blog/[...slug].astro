---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import type { GetStaticPaths } from 'astro';

export async function getStaticPaths() {
  const blogPosts = await getCollection('blog');
  return blogPosts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await post.render();

// Get all posts for sidebar
const allPosts = await getCollection('blog');
const sortedPosts = allPosts.sort((a, b) => {
  const dateA = a.data.pubDate instanceof Date ? a.data.pubDate : new Date(a.data.pubDate);
  const dateB = b.data.pubDate instanceof Date ? b.data.pubDate : new Date(b.data.pubDate);
  return dateB.getTime() - dateA.getTime(); // Newest first
});

// Group posts by category
const postsByCategory = sortedPosts.reduce((acc, post) => {
  const category = post.data.category;
  if (!acc[category]) {
    acc[category] = [];
  }
  acc[category].push(post);
  return acc;
}, {});

// Get current path for active state
const currentPath = Astro.url.pathname;

// Enhanced structured data
const structuredData = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": post.data.title,
  "description": post.data.description,
  "keywords": post.data.tags.join(", "),
  "author": {
    "@type": "Person",
    "name": "Aryan Singh",
    "url": "https://coderaryan.com/about",
    "jobTitle": "Software Engineer",
    "alumniOf": "Google"
  },
  "datePublished": post.data.pubDate.toISOString(),
  "dateModified": post.data.modifiedDate?.toISOString() || post.data.pubDate.toISOString(),
  "image": post.data.image || "https://coderaryan.com/images/blog-og.png",
  "publisher": {
    "@type": "Organization",
    "name": "Aryan Singh",
    "logo": {
      "@type": "ImageObject",
      "url": "https://coderaryan.com/logo.png"
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": new URL(Astro.url.pathname, Astro.site).toString()
  }
};

// Generate canonical URL
const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();

// Generate share URLs with UTM parameters
const shareText = `Check out "${post.data.title}" by @singh1aryan`;
const shareUrls = {
  twitter: `https://twitter.com/intent/tweet?text=${encodeURIComponent(shareText)}&url=${encodeURIComponent(canonicalURL)}&utm_source=twitter&utm_medium=social&utm_campaign=share`,
  linkedin: `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(canonicalURL)}&utm_source=linkedin&utm_medium=social&utm_campaign=share`
};
---

<Layout 
  title={post.data.title}
  description={post.data.description}
  image={post.data.image || "/images/blog-og.png"}
  article={true}
  publishDate={post.data.pubDate}
  author={post.data.author}
  canonicalURL={canonicalURL}
>
  <Fragment slot="head">
    <link rel="canonical" href={canonicalURL} />
    <meta property="article:published_time" content={post.data.pubDate.toISOString()} />
    {post.data.modifiedDate && 
      <meta property="article:modified_time" content={post.data.modifiedDate.toISOString()} />
    }
    <meta property="article:author" content="https://aryansingh.com/about" />
    {post.data.tags.map(tag => 
      <meta property="article:tag" content={tag} />
    )}
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </Fragment>

  <div class="flex min-h-screen relative">
    <!-- Floating Action Button Menu -->
    <div class="fixed bottom-6 right-6 flex flex-col gap-3 z-50">
      <!-- Table of Contents Button -->
      <button
        id="toc-button"
        class="md:hidden bg-white text-primary-600 p-3 rounded-full shadow-lg hover:bg-primary-50 transition-colors border-2 border-primary-200"
        aria-label="Table of Contents"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7" />
        </svg>
      </button>

      <!-- Navigation Button -->
      <button
        id="nav-button"
        class="md:hidden bg-primary-600 text-white p-3 rounded-full shadow-lg hover:bg-primary-700 transition-colors"
        aria-label="Navigation Menu"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path 
            id="menu-icon"
            stroke-linecap="round" 
            stroke-linejoin="round" 
            stroke-width="2" 
            d="M4 6h16M4 12h16M4 18h16"
          />
          <path 
            id="close-icon"
            class="hidden"
            stroke-linecap="round" 
            stroke-linejoin="round" 
            stroke-width="2" 
            d="M6 18L18 6M6 6l12 12"
          />
        </svg>
      </button>
    </div>

    <!-- Left Sidebar (Navigation) -->
    <aside 
      id="left-sidebar"
      class="fixed left-0 top-16 w-[85vw] md:w-72 h-[calc(100vh-4rem)] overflow-y-auto border-r border-gray-200 bg-white transform -translate-x-full transition-transform duration-200 ease-in-out md:translate-x-0 z-40"
    >
      <div class="p-6">
        <!-- Sidebar Header -->
        <div class="flex items-center gap-3 mb-6">
          <div class="w-8 h-8 bg-primary-100 rounded-lg flex items-center justify-center">
            <svg class="w-5 h-5 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9.5a2.5 2.5 0 00-2.5-2.5H15" />
            </svg>
          </div>
          <h2 class="text-lg font-bold text-gray-900">Blog Posts</h2>
        </div>

        <!-- Blog Categories -->
        <nav class="space-y-6">
          {Object.entries(postsByCategory).map(([category, posts]) => (
            <div>
              <div class="flex items-center gap-2 mb-2">
                <h3 class="text-sm font-semibold text-gray-900 uppercase tracking-wide">
                  {category.replace(/-/g, ' ')}
                </h3>
                <span class="text-xs bg-gray-100 text-gray-600 px-2 py-0.5 rounded-full">
                  {posts.length}
                </span>
              </div>
              <ul class="space-y-1">
                {posts.map((blogPost) => {
                  const isActive = currentPath === `/blog/${blogPost.slug}`;
                  return (
                    <li>
                      <a
                        href={`/blog/${blogPost.slug}`}
                        class={`
                          flex items-center gap-2 px-3 py-2 rounded-lg text-sm transition-colors
                          ${isActive 
                            ? 'bg-primary-50 text-primary-700 font-medium' 
                            : 'text-gray-600 hover:bg-gray-50 hover:text-gray-900'
                          }
                        `}
                      >
                        <svg 
                          class={`w-4 h-4 flex-shrink-0 ${isActive ? 'text-primary-600' : 'text-gray-400'}`}
                          fill="none" 
                          stroke="currentColor" 
                          viewBox="0 0 24 24"
                        >
                          <path 
                            stroke-linecap="round" 
                            stroke-linejoin="round" 
                            stroke-width="2" 
                            d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"
                          />
                        </svg>
                        <span class="truncate">{blogPost.data.title}</span>
                      </a>
                    </li>
                  );
                })}
              </ul>
            </div>
          ))}
        </nav>
      </div>
    </aside>

    <!-- Main Content -->
    <main class="w-full md:ml-72 lg:mr-64 flex-1 min-w-0 py-12 px-4 sm:px-6 lg:px-8">
      <article class="prose prose-lg max-w-3xl mx-auto">
        <!-- Article Header -->
        <header class="mb-8">
          <h1 class="mb-4">{post.data.title}</h1>
          <div class="flex flex-wrap items-center gap-3 text-sm text-gray-600">
            <time datetime={post.data.pubDate.toISOString()}>
              {new Date(post.data.pubDate).toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'long',
                day: 'numeric'
              })}
            </time>
            <span class="px-2 py-1 bg-primary-50 text-primary-700 rounded-full">
              {post.data.category.replace(/-/g, ' ')}
            </span>
          </div>
        </header>
        <Content />
      </article>
    </main>

    <!-- Right Sidebar (Table of Contents) -->
    <aside 
      id="right-sidebar"
      class="fixed right-0 top-16 w-[85vw] md:w-64 h-[calc(100vh-4rem)] overflow-y-auto border-l border-gray-200 bg-white transform translate-x-full transition-transform duration-200 ease-in-out lg:translate-x-0 z-40"
    >
      <div class="p-6">
        <div class="flex items-center gap-2 mb-4">
          <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7" />
          </svg>
          <h2 class="text-sm font-semibold text-gray-900 uppercase tracking-wide">
            Table of Contents
          </h2>
        </div>
        <nav class="space-y-1">
          {headings.map((heading) => (
            <a
              href={`#${heading.slug}`}
              class={`
                block py-2 pl-${(heading.depth - 1) * 4} text-sm
                ${heading.depth === 1 ? 'font-medium text-gray-900' : 'text-gray-600'}
                hover:text-primary-600 transition-colors
              `}
            >
              {heading.text}
            </a>
          ))}
        </nav>
      </div>
    </aside>

    <!-- Overlay -->
    <div 
      id="sidebar-overlay"
      class="fixed inset-0 bg-gray-800 bg-opacity-50 z-30 hidden md:hidden"
      aria-hidden="true"
    ></div>
  </div>

  <footer class="mt-12 pt-8 border-t border-gray-200">
    <div class="flex items-center justify-between">
      <div class="flex items-center space-x-4">
        <span class="text-gray-600">Share this post:</span>
        <a href="#" class="text-gray-600 hover:text-primary-600">
          <span class="sr-only">Twitter</span>
          <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M8.29 20.251c7.547 0 11.675-6.253 11.675-11.675 0-.178 0-.355-.012-.53A8.348 8.348 0 0022 5.92a8.19 8.19 0 01-2.357.646 4.118 4.118 0 001.804-2.27 8.224 8.224 0 01-2.605.996 4.107 4.107 0 00-6.993 3.743 11.65 11.65 0 01-8.457-4.287 4.106 4.106 0 001.27 5.477A4.072 4.072 0 012.8 9.713v.052a4.105 4.105 0 003.292 4.022 4.095 4.095 0 01-1.853.07 4.108 4.108 0 003.834 2.85A8.233 8.233 0 012 18.407a11.616 11.616 0 006.29 1.84"></path>
          </svg>
        </a>
        <a href="#" class="text-gray-600 hover:text-primary-600">
          <span class="sr-only">LinkedIn</span>
          <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
          </svg>
        </a>
      </div>
      <div class="flex items-center space-x-2">
        {post.data.tags.map(tag => (
          <span class="inline-block bg-gray-100 px-3 py-1 rounded-full text-sm text-gray-700">
            #{tag}
          </span>
        ))}
      </div>
    </div>
  </footer>
</Layout>

<style>
  /* Hide scrollbar for Chrome, Safari and Opera */
  aside::-webkit-scrollbar {
    display: none;
  }

  /* Hide scrollbar for IE, Edge and Firefox */
  aside {
    -ms-overflow-style: none;  /* IE and Edge */
    scrollbar-width: none;  /* Firefox */
  }

  /* Add smooth scrolling to the whole page */
  html {
    scroll-behavior: smooth;
  }

  /* Add responsive styles */
  @media (max-width: 768px) {
    .prose {
      font-size: 1rem;
      line-height: 1.6;
    }
    
    main {
      margin-left: 0;
      margin-right: 0;
      padding-bottom: 6rem; /* Space for FAB */
    }

    /* Improve mobile typography */
    .prose h1 {
      font-size: 2rem;
      line-height: 1.2;
    }

    .prose h2 {
      font-size: 1.5rem;
      margin-top: 2rem;
    }

    .prose p {
      margin-bottom: 1.25rem;
    }
  }
</style>

<script>
  const navButton = document.getElementById('nav-button');
  const tocButton = document.getElementById('toc-button');
  const leftSidebar = document.getElementById('left-sidebar');
  const rightSidebar = document.getElementById('right-sidebar');
  const overlay = document.getElementById('sidebar-overlay');
  const menuIcon = document.getElementById('menu-icon');
  const closeIcon = document.getElementById('close-icon');

  let activeMenu = null;

  function toggleMenu(side = 'left') {
    if (activeMenu === side) {
      // Close active menu
      leftSidebar?.classList.remove('translate-x-0');
      rightSidebar?.classList.remove('-translate-x-0');
      overlay?.classList.add('hidden');
      menuIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
      activeMenu = null;
    } else {
      // Close any open menu first
      leftSidebar?.classList.remove('translate-x-0');
      rightSidebar?.classList.remove('-translate-x-0');
      
      // Open selected menu
      if (side === 'left') {
        leftSidebar?.classList.add('translate-x-0');
      } else {
        rightSidebar?.classList.add('-translate-x-0');
      }
      
      overlay?.classList.remove('hidden');
      menuIcon?.classList.add('hidden');
      closeIcon?.classList.remove('hidden');
      activeMenu = side;
    }
  }

  // Navigation menu button
  navButton?.addEventListener('click', () => toggleMenu('left'));

  // Table of contents button
  tocButton?.addEventListener('click', () => toggleMenu('right'));

  // Close menu when overlay is clicked
  overlay?.addEventListener('click', () => toggleMenu());

  // Close menu when escape key is pressed
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && activeMenu) {
      toggleMenu();
    }
  });

  // Close menu when window is resized to desktop size
  window.addEventListener('resize', () => {
    if (window.innerWidth >= 768 && activeMenu) {
      toggleMenu();
    }
  });

  // Highlight current section in table of contents
  const observerOptions = {
    rootMargin: '0px 0px -66%',
    threshold: 1.0
  };

  const observer = new IntersectionObserver(entries => {
    entries.forEach(entry => {
      const id = entry.target.getAttribute('id');
      if (entry.isIntersecting) {
        document.querySelector(`nav a[href="#${id}"]`)
          ?.classList.add('text-primary-600', 'font-medium');
      } else {
        document.querySelector(`nav a[href="#${id}"]`)
          ?.classList.remove('text-primary-600', 'font-medium');
      }
    });
  }, observerOptions);

  // Track all sections that have an `id` applied
  document.querySelectorAll('h1[id], h2[id], h3[id], h4[id], h5[id], h6[id]')
    .forEach((section) => {
      observer.observe(section);
    });
</script>